diff --git a/scripts/test-audio-hal-stale-restart.py b/scripts/test-audio-hal-stale-restart.py
new file mode 100644
index 0000000..27a5ce2
--- /dev/null
+++ b/scripts/test-audio-hal-stale-restart.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""A guest restart that keeps the previous generation's audio HAL restarts the
+HAL, because the new audioserver cannot open the primary output on the old one
+(Galaxy A15 Infinity-X 16:10:33: createTrack error -19 for the whole session).
+A fresh HAL, or a first run, is left alone."""
+
+from pathlib import Path
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+START = (ROOT / "switcher/assets/guest_start.sh").read_text()
+BLOCK_ANCHOR = (
+    "hpid=$(dumpsys --pid android.hardware.audio.core.IModule/default"
+    " 2>/dev/null | head -n 1 | tr -dc 0-9)\n    hprev=$(cat /data/oneos_audio_hal.pid 2>/dev/null)"
+)
+END_ANCHOR = (
+    'if [ -n "$hpid" ]; then echo "$hpid" > /data/oneos_audio_hal.pid; fi\n    n=0'
+)
+
+
+def find_sh():
+    sh = shutil.which("sh")
+    if not sh and os.name == "nt":
+        candidate = (
+            Path(os.environ.get("ProgramFiles", r"C:\Program Files"))
+            / "Git/usr/bin/sh.exe"
+        )
+        if candidate.is_file():
+            sh = str(candidate)
+    return sh
+
+
+class AudioHalStaleRestartTest(unittest.TestCase):
+    def setUp(self):
+        self.assertEqual(1, START.count(BLOCK_ANCHOR))
+        self.assertEqual(1, START.count(END_ANCHOR))
+        # The pid is recorded twice: once in the block (after a restart), once
+        # right after the IModule wait, so a full launch's fresh HAL is recorded.
+        self.assertEqual(2, START.count('echo "$hpid" > /data/oneos_audio_hal.pid'))
+        block = BLOCK_ANCHOR + START.split(BLOCK_ANCHOR, 1)[1].split(END_ANCHOR, 1)[0] + END_ANCHOR
+        self.tmp = tempfile.TemporaryDirectory()
+        d = Path(self.tmp.name)
+        self.fix = d / "fix"
+        self.fix.mkdir()
+        self.pidfile = d / "oneos_audio_hal.pid"
+        self.block = block.replace(
+            "/data/oneos_audio_hal.pid", str(self.pidfile).replace("\\", "/")
+        )
+        for name, text in (
+            ("getprop", '#!/bin/sh\ncase "$1" in\n  ""|all) echo "[init.svc.vendor.audio-hal-2-0]: [running]" ;;\nesac\n'),
+            ("dumpsys", '#!/bin/sh\nif [ -e "$FIX/restarted" ]; then echo "$FAKE_NEW_PID"; else echo "$FAKE_OLD_PID"; fi\n'),
+            ("setprop", '#!/bin/sh\nprintf "%s\\n" "$@" >> "$FIX/setprop.log"\n[ "$1" = ctl.restart ] && : > "$FIX/restarted"\n'),
+            ("sleep", "#!/bin/sh\n"),
+        ):
+            p = self.fix / name
+            p.write_text(text, encoding="utf-8", newline="\n")
+            p.chmod(0o755)
+        self.sh = find_sh()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def run_block(self, old="2920", new="4311", pre_pid=None):
+        env = dict(os.environ)
+        env["PATH"] = f"{self.fix}{os.pathsep}{env.get('PATH', '')}"
+        env["FIX"] = str(self.fix)
+        env["FAKE_OLD_PID"] = old
+        env["FAKE_NEW_PID"] = new
+        if pre_pid is not None:
+            self.pidfile.write_text(pre_pid)
+        script = self.block + '\nprintf "%s" "$(cat ' + str(self.pidfile).replace("\\", "/") + ' 2>/dev/null)"'
+        out = subprocess.run(
+            [self.sh, "-c", script], env=env, capture_output=True, text=True, check=True
+        )
+        self.assertEqual("", out.stderr)
+        sp = self.fix / "setprop.log"
+        restarts = sp.read_text().splitlines() if sp.exists() else []
+        return out.stdout, restarts, (self.fix / "restarted").exists()
+
+    def test_stale_hal_is_restarted_through_its_init_services(self):
+        out, restarts, restarted = self.run_block(pre_pid="2920")
+        self.assertTrue(restarted)
+        self.assertEqual(["ctl.restart", "vendor.audio-hal-2-0"], restarts[0:2])
+        self.assertIn("audio HAL survived the guest restart as pid 2920", out)
+        self.assertIn("audio HAL pid after the restart: 4311", out)
+        self.assertEqual("4311", out.strip().splitlines()[-1])
+
+    def test_a_fresh_hal_is_left_alone_but_recorded(self):
+        out, restarts, restarted = self.run_block(pre_pid="4999")
+        self.assertFalse(restarted)
+        self.assertNotIn("survived the guest restart", out)
+        self.assertEqual("2920", out.strip())
+
+    def test_the_first_run_records_the_pid_without_restarting(self):
+        out, restarts, restarted = self.run_block()
+        self.assertFalse(restarted)
+        self.assertEqual("2920", out.strip())
+
+    def test_an_hal_that_survives_the_restart_call_is_killed(self):
+        # ctl.restart ran, but the stub keeps reporting the old pid: the block
+        # falls back to killing the pid so init starts the service again. The
+        # fake pid is not a real process here, so the kill is a no-op and the
+        # recorded pid stays the old one.
+        env = dict(os.environ)
+        env["PATH"] = f"{self.fix}{os.pathsep}{env.get('PATH', '')}"
+        env["FIX"] = str(self.fix)
+        env["FAKE_OLD_PID"] = "2920"
+        env["FAKE_NEW_PID"] = "2920"
+        self.pidfile.write_text("2920")
+        script = self.block + '\nprintf "%s" "$(cat ' + str(self.pidfile).replace("\\", "/") + ' 2>/dev/null)"'
+        out = subprocess.run(
+            [self.sh, "-c", script], env=env, capture_output=True, text=True, check=True
+        )
+        self.assertIn("still pid 2920 after the ctl.restart; killing it", out.stdout)
+        self.assertIn("audio HAL pid after the restart: 2920 (waited 20s)", out.stdout)
+        self.assertEqual("2920", out.stdout.strip().splitlines()[-1])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/scripts/test-bl-bridge-watch.py b/scripts/test-bl-bridge-watch.py
new file mode 100644
index 0000000..725888a
--- /dev/null
+++ b/scripts/test-bl-bridge-watch.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""The brightness bridge takes the panel node over only from a dead lights HAL.
+
+Extracts the bridge script from guest_start.sh's heredoc and runs it with
+stubs (Windows-portable under Git Bash's sh). Three cases:
+
+1. Deaf HAL: the node sits at 0 while the screen is awake and asks for light
+   -> the bridge takes the node over and writes proportional values.
+2. Healthy HAL: the node moves on its own -> the bridge leaves it alone.
+3. The guest asks for dark: a node at 0 with the brightness at minimum is a
+   wish, not a dead HAL -> no takeover.
+
+The write loop never ends on its own, so the takeover case runs under a
+subprocess timeout and the assertions read the log and the node file.
+"""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = (ROOT / 'switcher/assets/guest_start.sh').read_text()
+BODY = re.search(r"cat > /data/oneos_bl_bridge\.sh <<'BLEOF'\n(.*?)\nBLEOF\n",
+                 SOURCE, re.S).group(1)
+
+
+def posix(p: Path) -> str:
+    s = str(p).replace('\\', '/')
+    return re.sub(r'^([A-Za-z]):', lambda m: '/' + m.group(1).lower(), s)
+
+
+class BlBridgeWatch(unittest.TestCase):
+    def run_bridge(self, node, brightness, wakefulness='Awake', timeout=90, env=None):
+        # The production watch cap is 600 s; the same decision runs here with a
+        # small cap so a "left alone" case finishes in seconds. The write loop
+        # (in production: until the session ends) is bounded too — the test
+        # asserts on what it wrote, not on it running forever.
+        body = (BODY.replace('-lt 600', '-lt 18')
+                    .replace('while :; do', 'w_n=0; while [ $w_n -lt 25 ]; do w_n=$((w_n + 1));'))
+        with tempfile.TemporaryDirectory() as d:
+            root = Path(d)
+            (root / 'bin').mkdir()
+            stubs = {
+                'sleep': '#!/bin/sh\nexit 0\n',
+                'dumpsys': ('#!/bin/sh\n'
+                            'case "$1" in\n'
+                            '  display) [ -f "$WD/display" ] && cat "$WD/display" ;;\n'
+                            '  power) cat "$WD/power" ;;\n'
+                            'esac\n'),
+                'cmd': ('#!/bin/sh\n'
+                        '[ "$1" = display ] && [ "$2" = get-brightness ] && cat "$WD/brightness_out"\n'),
+                'getprop': '#!/bin/sh\necho 1\n',
+            }
+            for name, c in stubs.items():
+                p = root / 'bin' / name
+                p.write_text(c)
+                p.chmod(0o755)
+            (root / 'display').write_text(
+                '  mScreenBrightnessRangeMinimum=0.0\n'
+                '  mScreenBrightnessRangeMaximum=1.0\n'
+                '  mScreenBrightnessNormalMaximum=1.0\n'
+                '  useSurfaceControl=false (force_anyway? false)\n')
+            (root / 'power').write_text(f'  mWakefulness={wakefulness}\n')
+            (root / 'brightness_out').write_text(f'{brightness}\n')
+            (root / 'node').write_text(f'{node}\n')
+            log = root / 'backlight.log'
+            e = {k: v for k, v in os.environ.items() if k in ('SYSTEMROOT', 'WINDIR', 'TMP', 'TEMP')}
+            wd = posix(root)
+            e['PATH'] = f'{wd}/bin:/usr/bin:/bin'
+            e['WD'] = wd
+            for k, v in (env or {}).items():
+                e[k] = v
+            # The bridge logs to its stdout; a "left alone" run exits 0 on its
+            # own, a takeover run is stopped by the subprocess timeout.
+            code = (body.replace("$BL/brightness", f'"{wd}/node"'))
+            try:
+                out = subprocess.run(
+                    ['sh', '-c', f'cd "{wd}" && exec sh -c {repr_shell(code)} sh "'
+                                 f'{posix(root / "node")}" 483 193 0'],
+                    env=e, capture_output=True, text=True, timeout=timeout)
+                text, finished = out.stdout or '', out.returncode == 0
+            except subprocess.TimeoutExpired as t:
+                text, finished = (t.stdout or '').decode() if isinstance(t.stdout, bytes) else (t.stdout or ''), False
+            return text, ((root / 'node').read_text() or '').strip(), finished
+
+    def test_the_script_is_extracted(self):
+        self.assertIn('mWakefulness', BODY)
+        self.assertIn('taking the node over', BODY)
+        self.assertIn('leaving it to the lights HAL', BODY)
+
+    def test_a_dead_hal_is_taken_over(self):
+        log, node, finished = self.run_bridge(node=0, brightness=0.35)
+        self.assertTrue(finished, 'the bounded write loop should run to its cap')
+        self.assertIn('taking the node over', log)
+        self.assertNotIn('leaving it to the lights HAL', log)
+        # The write loop then drives the node proportionally (0.35 of the
+        # guest's normal 255 = 89).
+        self.assertEqual('89', node)
+
+    def test_a_live_node_is_left_alone(self):
+        log, node, finished = self.run_bridge(node=25, brightness=0.35)
+        self.assertTrue(finished, 'the 600 s watch cap should end the run')
+        self.assertIn('leaving it to the lights HAL', log)
+        self.assertNotIn('taking the node over', log)
+        self.assertEqual('25', node)
+
+    def test_a_minimum_setting_is_a_wish_not_a_dead_hal(self):
+        log, node, finished = self.run_bridge(node=0, brightness=0.01)
+        self.assertTrue(finished, 'the 600 s watch cap should end the run')
+        self.assertIn('leaving it to the lights HAL', log)
+        self.assertNotIn('taking the node over', log)
+
+    def test_an_asleep_screen_does_not_count(self):
+        log, node, finished = self.run_bridge(node=0, brightness=0.35,
+                                              wakefulness='Asleep')
+        self.assertTrue(finished)
+        self.assertIn('leaving it to the lights HAL', log)
+        self.assertNotIn('taking the node over', log)
+
+    def test_force_takes_a_thrashing_node_over(self):
+        # A stage whose HAL thrashes the node (values jump while the slider sits
+        # still) never satisfies the dead-node watch; ONEOS_GUEST_BL_BRIDGE=force
+        # takes the node over unconditionally and drives it proportionally.
+        log, node, finished = self.run_bridge(node=25, brightness=0.35,
+                                              env={'ONEOS_GUEST_BL_BRIDGE': 'force'})
+        self.assertTrue(finished, 'the bounded write loop should run to its cap')
+        self.assertIn('forced by ONEOS_GUEST_BL_BRIDGE=force', log)
+        self.assertNotIn('leaving it to the lights HAL', log)
+        self.assertEqual('89', node)
+
+    def test_force_off_leaves_a_live_node_alone(self):
+        log, node, finished = self.run_bridge(node=25, brightness=0.35)
+        self.assertIn('leaving it to the lights HAL', log)
+        self.assertEqual('25', node)
+
+
+def repr_shell(s: str) -> str:
+    return "'" + s.replace("'", "'\\''") + "'"
+
+
+if __name__ == '__main__':
+    unittest.main()
