diff --git a/switcher/patches/OneOSAudioParam.java b/switcher/patches/OneOSAudioParam.java
new file mode 100644
index 0000000..d42144c
--- /dev/null
+++ b/switcher/patches/OneOSAudioParam.java
@@ -0,0 +1,19 @@
+/**
+ * OneOS (0.5.17): one key=value pair to AudioFlinger through the guest's own AudioSystem.setParameters, so the
+ * binder call number is always this build's. guest_start.sh sent `service call media.audio_flinger 18`, which is
+ * setParameters only in some builds (OxygenOS 16 on the A17: 20; a tester's module found it): there the Bluetooth
+ * stream recovery and the call SIM slot did nothing. Run in the guest: app_process ... OneOSAudioParam "key=value".
+ * Exits non-zero when the call could not be made, so the script can fall back.
+ */
+public final class OneOSAudioParam {
+    public static void main(String[] args) throws Exception {
+        if (args.length != 1 || !args[0].matches("[A-Za-z0-9_.]{1,64}=[A-Za-z0-9_.,-]{0,64}")) {
+            System.out.println("usage: OneOSAudioParam key=value");
+            System.exit(2);
+        }
+        Class<?> as = Class.forName("android.media.AudioSystem");
+        int r = (Integer) as.getMethod("setParameters", String.class).invoke(null, args[0]);
+        System.out.println("AudioSystem.setParameters " + args[0] + ": " + r);
+        System.exit(r == 0 ? 0 : 1);
+    }
+}
diff --git a/switcher/patches/OneOSCfmsStub.java b/switcher/patches/OneOSCfmsStub.java
new file mode 100644
index 0000000..2e2f8df
--- /dev/null
+++ b/switcher/patches/OneOSCfmsStub.java
@@ -0,0 +1,47 @@
+import android.os.*;
+import java.io.File;
+import java.lang.reflect.Method;
+
+/**
+ * OneOS (0.5.17): stands in for One UI's "CustomFrequencyManagerService" (CFMS) while the guest runs, like
+ * OneOSEdmStub for Knox. One UI's libgui in the shared cameraserver asks for CFMS on every camera Surface it
+ * creates; only One UI's system_server registers it, so on the Galaxy S26 Exynos each lookup waited libbinder's
+ * full 5 s ("Service CustomFrequencyManagerService didn't start. Returning NULL", "Failed to get CFMS service"):
+ * 23 waits in one ColorOS session, stream configuration 5102 ms, Samsung Camera timed out waiting for frames
+ * (report 7f0b2f5e and every S942B report since 0.5.11). CFMS only asks for CPU/GPU frequency boosts, which are
+ * optional; every call is answered "no exception, nothing" (int32 0), so the lookup is immediate and no boost is
+ * ever taken. Re-registers if the name goes; exits with the guest. ONEOS_GUEST_CFMS_STUB=0: off.
+ * Run in the guest: app_process ... OneOSCfmsStub <guest system_server pid>.
+ */
+public final class OneOSCfmsStub {
+ private static final String NAME = "CustomFrequencyManagerService";
+
+ public static void main(String[] args) throws Exception {
+  final int guest = Integer.parseInt(args[0]);
+  Looper.prepareMainLooper();
+  final Binder b = new Binder() {
+   @Override protected boolean onTransact(int code, Parcel data, Parcel reply, int flags) throws RemoteException {
+    if (code == INTERFACE_TRANSACTION) { if (reply != null) reply.writeString("android.os.ICustomFrequencyManager"); return true; }
+    if (reply != null) { reply.writeInt(0); reply.writeInt(0); }
+    return true;
+   }
+  };
+  final Class<?> sm = Class.forName("android.os.ServiceManager");
+  final Method add = sm.getMethod("addService", String.class, IBinder.class, boolean.class, int.class);
+  final Method check = sm.getMethod("checkService", String.class);
+  if (check.invoke(null, NAME) != null) { System.out.println("CFMS already registered; nothing to do"); return; }
+  add.invoke(null, NAME, b, Boolean.FALSE, Integer.valueOf(1));
+  if (check.invoke(null, NAME) == null) throw new IllegalStateException("addService " + NAME + " did not take");
+  System.out.println("READY " + NAME + " uid=" + android.os.Process.myUid() + " guest=" + guest);
+  System.out.flush();
+  final Handler h = new Handler(Looper.myLooper());
+  h.postDelayed(new Runnable() { public void run() {
+   if (!new File("/proc/" + guest).exists()) { System.out.println("EXIT guest " + guest + " gone"); System.out.flush(); System.exit(0); }
+   try {
+    if (check.invoke(null, NAME) == null) { add.invoke(null, NAME, b, Boolean.FALSE, Integer.valueOf(1)); System.out.println("REREGISTERED " + NAME); System.out.flush(); }
+   } catch (Throwable t) { System.out.println("recheck failed: " + t); System.out.flush(); }
+   h.postDelayed(this, 2000);
+  } }, 2000);
+  Looper.loop();
+ }
+}
diff --git a/switcher/patches/OneOSFpTouch.java b/switcher/patches/OneOSFpTouch.java
new file mode 100644
index 0000000..a946dec
--- /dev/null
+++ b/switcher/patches/OneOSFpTouch.java
@@ -0,0 +1,448 @@
+package com.android.server.biometrics.sensors.fingerprint.aidl;
+
+import android.os.SystemClock;
+import android.util.Log;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileReader;
+import java.io.InputStream;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+
+/**
+ * OneOS (0.5.20): a finger on a Galaxy's optical in-display sensor, for a guest whose own SystemUI never reports it.
+ *
+ * ColorOS draws its fingerprint icon but never calls FingerprintProvider.onPointerDown: on OPPO's phones the touch
+ * panel driver tells OPPO's fingerprint HAL of a finger on the sensor, and a Galaxy's panel and HAL have no such
+ * path (owner's A36, ColorOS 17: the icon showed, touching it did nothing, no pointer call in the log). This thread
+ * reads the touch panel itself (the evdev node guest_prepare.sh names in /data/system/oneos_fp_touch, read beside
+ * the guest's InputReader) and, while a fingerprint client (authentication or enrolment) is running, turns a finger
+ * landing in the sensor circle (/data/system/oneos_udfps) into FingerprintProvider.onPointerDown and its lifting into
+ * onPointerUp, the calls a stock SystemUI makes; OneOSSehTouch (guest_seh_touch.py) then lights the spot and tells
+ * Samsung's HAL, as for Nothing OS.
+ *
+ * FingerprintProvider's constructor calls start() (patches/guest_fp_touchwatch.py). Without the two files, or on any
+ * error, nothing runs and the guest behaves as before.
+ */
+public final class OneOSFpTouch implements Runnable {
+    private static final String TAG = "OneOSFpTouch";
+    private static final int EV_SYN = 0;
+    private static final int EV_ABS = 3;
+    private static final int ABS_MT_SLOT = 0x2f;
+    private static final int ABS_MT_POSITION_X = 0x35;
+    private static final int ABS_MT_POSITION_Y = 0x36;
+    private static final int ABS_MT_TRACKING_ID = 0x39;
+    private static final int SLOTS = 10;
+
+    private static boolean sStarted;
+
+    private final Object mProvider;
+    private final String mDevice;
