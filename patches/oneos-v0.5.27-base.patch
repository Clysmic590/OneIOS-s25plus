diff --git a/switcher/patches/policy_metadata_init.py b/switcher/patches/policy_metadata_init.py
new file mode 100644
index 0000000..7be1475
--- /dev/null
+++ b/switcher/patches/policy_metadata_init.py
@@ -0,0 +1,68 @@
+"""A rebuilt framework.jar initializes its device-policy groups itself.
+
+Android 17's android.app.admin.metadata.GeneratedPolicyMetadata is filled by the static
+initializers of the policy-group classes (SecurityPolicies, CrossDevicePolicies, ...), each
+calling addPolicySupplier. The image's boot image has those classes initialized; a patched
+framework.jar (framework_patched.jar) no longer matches it, so nothing ran them and
+DevicePolicyManagerService died at boot ("Policy identifier TASK_CONTINUITY_HANDOFF could not be
+found", One UI 9.5 on the A36, run 6). ensureInitialized() now loads every such class first
+(Class.forName initializes it; a class already initialized is not run twice).
+
+Usage: policy_metadata_init.py <apktool -r dir of framework.jar>
+Prints the smali_* directory it changed; nothing (and "not present" on stderr) when the
+framework has no GeneratedPolicyMetadata.
+"""
+import os
+import re
+import sys
+
+META = "Landroid/app/admin/metadata/GeneratedPolicyMetadata;"
+CALL = META + "->addPolicySupplier(Ljava/util/function/Supplier;)V"
+HEADER = ".method private static blacklist ensureInitialized()V"
+
+
+def main(root):
+    meta, groups = None, []
+    for d, _, fs in os.walk(root):
+        for f in fs:
+            if not f.endswith(".smali"):
+                continue
+            p = os.path.join(d, f)
+            t = open(p, errors="replace").read()
+            first = t.split("\n", 1)[0]
+            if first.endswith(" " + META):
+                meta = p
+            elif CALL in t:
+                m = re.match(r"\.class[^\n]* L([^;]+);", first)
+                clinit = re.search(r"^\.method static constructor [^\n]*<clinit>\(\)V\n(.*?)^\.end method", t, re.M | re.S)
+                if not m or not clinit or CALL not in clinit.group(1):
+                    sys.exit(f"{p}: addPolicySupplier outside a static initializer; not patched")
+                groups.append(m.group(1).replace("/", "."))
+    if meta is None:
+        print("policy_metadata_init: GeneratedPolicyMetadata not present", file=sys.stderr)
+        return
+    if not groups:
+        # Nothing to run (HyperOS OS4.0.5 Global, 11-19): no group fills the registry from a static initializer,
+        # so a missing boot image cannot leave it empty.
+        print("policy_metadata_init: no policy group registers itself; not needed", file=sys.stderr)
+        return
+    text = open(meta).read()
+    hdr = re.search(r"^\.method (?:private )?static (?:[a-z-]+ )*ensureInitialized\(\)V\n    \.locals (\d+)\n", text, re.M)
+    if not hdr or text.count("ensureInitialized()V\n    .locals") != 1 or int(hdr.group(1)) < 1:
+        sys.exit("policy_metadata_init: ensureInitialized()V not found once with a register; not patched")
+    if "OneOS: policy groups" in text:
+        print("policy_metadata_init: already patched", file=sys.stderr)
+        return
+    add = "\n    # OneOS: policy groups initialized here (no boot image for a patched framework.jar)\n"
+    for g in sorted(groups):
+        add += f'    const-string v0, "{g}"\n\n    invoke-static {{v0}}, Ljava/lang/Class;->forName(Ljava/lang/String;)Ljava/lang/Class;\n\n'
+    text = text[:hdr.end()] + add + text[hdr.end():]
+    open(meta, "w").write(text)
+    print(f"policy_metadata_init: ensureInitialized loads {len(groups)} policy groups", file=sys.stderr)
+    print(os.path.relpath(meta, root).split(os.sep)[0])
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    main(sys.argv[1])
diff --git a/switcher/patches/samsung_highspeed_surfaces.py b/switcher/patches/samsung_highspeed_surfaces.py
new file mode 100644
index 0000000..b4b8f32
--- /dev/null
+++ b/switcher/patches/samsung_highspeed_surfaces.py
@@ -0,0 +1,36 @@
+"""Samsung Camera's slow motion in an AOSP guest: up to 4 outputs in a constrained high-speed session.
+
+Samsung's camera opens its slow-motion session with three outputs (preview, recorder and a
+1280x720 YUV stream for its own analysis). One UI's framework allows that; AOSP's
+SurfaceUtils.checkConstrainedHighSpeedSurfaces throws for more than two ("Output target
+surface list must not be null and the size must be 1 or 2"), the camera's
+createHighSpeedCaptureSession failed and it stayed on a frozen preview (Galaxy A36
+LineageOS, 2026-11-15). The guest's camera calls go to One UI's cameraserver
+(pixel_camera_abi.py), which takes Samsung's three-stream session as it does in One UI.
+Only the count changes: 2 -> 4.
+Usage: samsung_highspeed_surfaces.py <decoded framework dir>; prints the smali_classes dir it changed.
+"""
+import glob
+import os
+import re
+import sys
+
+root = sys.argv[1]
+hits = glob.glob(os.path.join(root, 'smali*/android/hardware/camera2/utils/SurfaceUtils.smali'))
+if not hits:
+    sys.exit(0)
+path = hits[0]
+s = open(path).read()
+m = re.search(r'\.method public static [^\n]*checkConstrainedHighSpeedSurfaces\(Ljava/util/Collection;[^\n]*\n(.*?)\.end method', s, re.S)
+if not m:
+    sys.exit(0)
+body = m.group(1)
+pat = re.compile(r'(invoke-interface \{p0\}, Ljava/util/Collection;->size\(\)I\n\s*move-result (v\d+)\n\s*const/4 (v\d+), )0x2(\n\s*if-gt \2, \3, :cond_\w+)')
+new, n = pat.subn(r'\g<1>0x4\4', body, count=1)
+if n != 1:
+    if re.search(r'const/4 v\d+, 0x4\n\s*if-gt', body):
+        sys.exit(0)  # already patched
+    sys.exit('SurfaceUtils.checkConstrainedHighSpeedSurfaces: the size check is not in the expected form')
+s = s[:m.start(1)] + new + s[m.end(1):]
+open(path, 'w').write(s)
+print(os.path.relpath(path, root).split('/')[0])
diff --git a/switcher/patches/samsung_no_knoxguard30.py b/switcher/patches/samsung_no_knoxguard30.py
new file mode 100644
index 0000000..273c3ef
--- /dev/null
+++ b/switcher/patches/samsung_no_knoxguard30.py
@@ -0,0 +1,48 @@
+"""A One UI guest never starts KnoxGuard 3.0 (knoxguard_service).
+
+One UI 9.5's SystemServer starts com.samsung.android.knoxguard30.service.KnoxGuard30Service
+unless FactoryTest.isFactoryBinary(). In a guest it cannot reach the phone's KnoxGuard TA (One UI's,
+kept out of reach on purpose), read that as a fault, and locked the guest's screen: first "Device
+locked ... 1100FF02" through the KnoxGuard app, then, with that app hidden, "Security issue
+detected ... 8135" from the service itself, asking to turn on mobile data to report to Samsung's
+server (A36 runs 9 and 10). The factory-build branch is taken always: the service is not created
+or registered, which is the state Samsung's own factory builds run in.
+
+Usage: samsung_no_knoxguard30.py <smali root of services.jar>
+Prints the smali_* directory it changed; nothing when the build has no KnoxGuard 3.0.
+"""
+import os
+import re
+import sys
+
+PAT = re.compile(
+    r"(    invoke-static \{\}, Landroid/os/FactoryTest;->isFactoryBinary\(\)Z\n\n    move-result (v\d+)\n\n)"
+    r"    if-nez \2, (:cond_\w+)\n(\n    const-string(?:/jumbo)? \2, \"StartKnoxGuard\"\n)")
+
+
+def main(root):
+    hits = [os.path.join(d, f) for d, _, fs in os.walk(root) for f in fs
+            if os.path.join(d, f).endswith(os.sep + os.path.join("com", "android", "server", "SystemServer.smali"))]
+    if len(hits) != 1:
+        sys.exit(f"SystemServer.smali: {len(hits)} found")
+    text = open(hits[0]).read()
+    if "Lcom/samsung/android/knoxguard30/service/KnoxGuard30Service;-><init>" not in text:
+        print("KnoxGuard 3.0: not in this build", file=sys.stderr)
+        return
+    if "OneOS: KnoxGuard 3.0 not started" in text:
+        print("KnoxGuard 3.0: already patched", file=sys.stderr)
+        return
+    found = PAT.findall(text)
+    if len(found) != 1:
+        sys.exit(f"KnoxGuard 3.0: the factory-build check before StartKnoxGuard found {len(found)} times (one expected)")
+    text = PAT.sub(lambda m: m.group(1) + "    # OneOS: KnoxGuard 3.0 not started in a guest (as on a factory build)\n"
+                   + f"    goto {m.group(3)}\n" + m.group(4), text)
+    open(hits[0], "w").write(text)
+    print("KnoxGuard 3.0: knoxguard_service not started (factory-build branch always)", file=sys.stderr)
+    print(os.path.relpath(hits[0], root).split(os.sep)[0])
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    main(sys.argv[1])
