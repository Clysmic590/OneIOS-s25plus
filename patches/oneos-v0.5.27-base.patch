@@ -137,7 +141,7 @@ def patch_proxy(text, iface, host, guest, changed):
         if name is None or TRANSACT not in body or name not in guest:
             continue
         gcode, gsig = guest[name]
-        if name not in host:
+        if name not in host or name in NOT_TO_HOST:
