@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""One UI 9.5's engineering-mode client stays off where the phone has no ISehEngmode HAL.
+
+Every engmode call in One UI 9.5 goes through framework.jar's EngineeringModeManager, whose
+EngineeringModeNative loads lib.engmodejni.samsung.so; lib.engmode.samsung.so then asks for the AIDL
+HAL vendor.samsung.hardware.security.engmode.ISehEngmode/default with AServiceManager_waitForService.
+The S23 family's vendor serves only the older HIDL engmode, so the instance is not in the phone's
+VINTF manifest, init refuses to start it and every caller waits forever: SecSetupWizard's main thread
+(ANR, black setup screen), system_server's android.fg (FactoryBootModeUtils at BOOT_COMPLETED, "ANR in
+system") and SettingsProvider handler, SystemUI, diagmonagent (report 4dee9fd6, S23 Ultra).
+
+EngineeringModeNative's constructor gets a check after the library loaded: when servicemanager says
+the instance is not declared, mSupportJNI is set false, the state One UI already has when the library
+fails to load. isConnected() is then false and every EngineeringModeManager call returns its error
+value at once (all of them check isSupport() first). Where the instance is declared (S24 and later),
+or the check itself throws, nothing changes.
+
+Usage: oneui_engmode_undeclared.py <apktool -r dir of framework.jar>
+Prints the smali_* directory it changed; nothing (and "not present" on stderr) without the class.
+Exits 1 when the class is there but its constructor is not the expected shape.
+"""
+import os
+import re
+import sys
+
+REL = os.path.join("com", "samsung", "android", "service", "EngineeringMode",
+                   "EngineeringModeManager$EngineeringModeNative.smali")
+CLASS = "Lcom/samsung/android/service/EngineeringMode/EngineeringModeManager$EngineeringModeNative;"
+FIELD = CLASS + "->mSupportJNI:Z"
+INSTANCE = "vendor.samsung.hardware.security.engmode.ISehEngmode/default"
+MARK = "    # OneOS: engmode off without a declared ISehEngmode (oneui_engmode_undeclared.py)\n"
+# The end of the library's try block: the success path returns right after it.
+ANCHOR = ("    :try_end_0\n"
+          "    .catch Ljava/lang/Exception; {:try_start_0 .. :try_end_0} :catch_0\n"
+          "\n"
+          "    return-void\n")
+
+
+def main(root):
+    hits = [d for d in sorted(os.listdir(root))
+            if d.startswith("smali") and os.path.isfile(os.path.join(root, d, REL))]
+    if not hits:
+        print("not present", file=sys.stderr)
+        return
+    if len(hits) != 1:
+        sys.exit(f"oneui_engmode_undeclared: {REL} found in {hits}")
+    p = os.path.join(root, hits[0], REL)
+    t = open(p).read()
+    if MARK in t:
+        print(hits[0])
+        return
+    ms = list(re.finditer(r"^\.method public constructor [^\n]*<init>\(Lcom/samsung/android/service/"
+                          r"EngineeringMode/EngineeringModeManager;Landroid/content/Context;\)V\n(.*?)^\.end method",
+                          t, re.M | re.S))
+    if len(ms) != 1:
+        sys.exit(f"oneui_engmode_undeclared: {len(ms)} constructors; not patched")
+    m = ms[0]
+    body = m.group(1)
+    checks = {
+        "loads .engmodejni.samsung": 'const-string p1, ".engmodejni.samsung"\n\n    invoke-static {p1}, Ljava/lang/System;->loadLibrary(Ljava/lang/String;)V\n',
+        "sets mSupportJNI true": f"    const/4 p1, 0x1\n\n    .line 131\n    iput-boolean p1, p0, {FIELD}\n",
+        "logs with v0 the tag": '    const-string/jumbo v0, "engmode_java_manager"\n',
+        "one local": "    .locals 1\n",
+    }
+    for what, s in checks.items():
+        if body.count(s) != 1:
+            sys.exit(f"oneui_engmode_undeclared: constructor no longer {what}; not patched")
+    if body.count(ANCHOR) != 1 or body.count("return-void") != 2:
+        sys.exit("oneui_engmode_undeclared: constructor's success return not found once; not patched")
+    add = (MARK +
+           f'    const-string/jumbo p1, "{INSTANCE}"\n\n'
+           "    :try_start_oneos_em\n"
+           "    invoke-static {p1}, Landroid/os/ServiceManager;->isDeclared(Ljava/lang/String;)Z\n\n"
+           "    move-result p1\n"
+           "    :try_end_oneos_em\n"
+           "    .catch Ljava/lang/Throwable; {:try_start_oneos_em .. :try_end_oneos_em} :oneos_em_keep\n\n"
+           "    if-nez p1, :oneos_em_keep\n\n"
+           "    const/4 p1, 0x0\n\n"
+           f"    iput-boolean p1, p0, {FIELD}\n\n"
+           '    const-string/jumbo p1, "OneOS: ISehEngmode/default is not declared on this phone, em library off"\n\n'
+           "    invoke-static {v0, p1}, Landroid/util/Log;->w(Ljava/lang/String;Ljava/lang/String;)I\n\n"
+           "    :oneos_em_keep\n")
+    new = ANCHOR.replace("    return-void\n", add + "    return-void\n")
+    body = body.replace(ANCHOR, new)
+    t = t[:m.start(1)] + body + t[m.end(1):]
+    with open(p, "w") as f:
+        f.write(t)
+    print(hits[0])
+    print("engmode: off when ISehEngmode/default is not declared", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/switcher/patches/oneui_mmac_empty_signer.py b/switcher/patches/oneui_mmac_empty_signer.py
new file mode 100755
index 0000000..5f4b239
--- /dev/null
+++ b/switcher/patches/oneui_mmac_empty_signer.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""One UI 9.5 set r6: a <signer> stanza left empty by ignore_mac_permissions_package no longer stops boot.
+
+One UI 9.5 (S26) has the flag ignore_mac_permissions_package on, so SELinuxMMAC.readSignerOrThrow drops every
+<package> tag ("<package> tag found but flag ignore_mac_permissions_package is enabled. This tag will be
+ignored."). The phone's own /vendor/etc/selinux/vendor_mac_permissions.xml on older Galaxies has signer
+stanzas made only of <package> tags; with those dropped the stanza has neither a seinfo nor a package, the
+"Only seinfo tag XOR package tags are allowed within a signer stanza." check throws, readInstallPolicy fails
+and PackageManagerService stops system_server: "Unable to load SELinux MMAC policy" (11-19 reports 3aa2f42d
+A07, 2f5486ae S23; earlier Fold8).
+
+Such a stanza is dropped: readSignerOrThrow returns null for it and readInstallPolicy, its only caller, adds
+nothing, so those apps fall through to the other stanzas and the default, as the flag means them to. (Kept
+as an empty Policy it would sort as a duplicate of the platform's stanza with the same certificate, which
+fails the whole policy too.) A stanza with both a seinfo and packages still throws. Fail-closed: the check
+and the call must each be found exactly once in the expected shape.
+
+    oneui_mmac_empty_signer.py <services smali dir>   -> prints the smali dir it changed
+"""
+import os
+import re
+import sys
+
+CLS = "com/android/server/pm/SELinuxMMAC.smali"
+MARK = "    # OneOS: a signer emptied by ignore_mac_permissions_package is dropped (oneui_mmac_empty_signer.py)\n"
+CALL = re.compile(r"^    invoke-static \{(v\d+)\}, Lcom/android/server/pm/SELinuxMMAC;->readSignerOrThrow\(Lorg/xmlpull/v1/XmlPullParser;\)"
+                  r"Lcom/android/server/pm/Policy;\n\n    move-result-object (v\d+)\n\n"
+                  r"(    invoke-virtual \{v\d+, \2\}, Ljava/util/ArrayList;->add\(Ljava/lang/Object;\)Z\n\n    goto (:goto_\w+)\n)", re.M)
+# :cond_b is reached when (seinfo == null) == pkgMap.isEmpty(): both empty or both set. The seinfo register is
+# the one tested before the xor; the Policy is p0.
+SHAPE = re.compile(
+    r"^    if-nez (v\d+), (:cond_\w+)\n\n    const/4 (v\d+), 0x1\n\n    goto (:goto_\w+)\n\n    \2\n    const/4 \3, 0x0\n\n"
+    r"    \4\n    invoke-interface \{(v\d+)\}, Ljava/util/Map;->isEmpty\(\)Z\n\n    move-result \5\n\n    xor-int/2addr \3, \5\n\n"
+    r"    if-eqz \3, (:cond_\w+)\n\n    return-object p0\n\n    \6\n"
+    r"(    const-string/jumbo p0, \"Only seinfo tag XOR package tags are allowed within a signer stanza\.\"\n)", re.M)
+
+
+def main():
+    root = sys.argv[1]
+    hits = [d for d in sorted(os.listdir(root)) if d.startswith("smali") and os.path.isfile(os.path.join(root, d, CLS))]
+    if len(hits) != 1:
+        sys.exit(f"oneui_mmac_empty_signer: {CLS} found in {hits or 'no smali dir'}")
+    path = os.path.join(root, hits[0], CLS)
+    src = open(path).read()
+    if MARK in src:
+        print(hits[0])
+        return
+    found = list(SHAPE.finditer(src))
+    if len(found) != 1:
+        sys.exit(f"oneui_mmac_empty_signer: the signer XOR check found {len(found)} times in the expected shape")
+    calls = list(CALL.finditer(src))
+    if len(calls) != 1:
+        sys.exit(f"oneui_mmac_empty_signer: the readSignerOrThrow call found {len(calls)} times in the expected shape")
+    m = found[0]
+    seinfo = m.group(1)
+    add = (MARK +
+           f"    if-nez {seinfo}, :oneos_mmac_both_set\n\n"
+           "    const/4 p0, 0x0\n\n"
+           "    return-object p0\n\n"
+           "    :oneos_mmac_both_set\n")
+    c = calls[0]
+    skip = MARK + f"    if-eqz {c.group(2)}, {c.group(4)}\n\n"
+    # The call comes before the check in the file; insert at the later offset first.
+    assert c.start(3) < m.start(7)
+    src = src[:m.start(7)] + add + src[m.start(7):]
+    src = src[:c.start(3)] + skip + src[c.start(3):]
+    with open(path, "w") as f:
+        f.write(src)
+    print(hits[0])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/switcher/patches/oneui_no_privacy_display.py b/switcher/patches/oneui_no_privacy_display.py
new file mode 100644
index 0000000..6af86e2
--- /dev/null
+++ b/switcher/patches/oneui_no_privacy_display.py
@@ -0,0 +1,54 @@
+"""One UI 9.5's Privacy Display stays off on phones without its panel.
+
+Privacy Display is the Galaxy S26 Ultra's panel feature. One UI 9.5's framework.jar sets its flags
+(com.samsung.android.rune.CoreRune FW_PRIVACY_DISPLAY, FW_PARTIAL_PRIVACY_DISPLAY,
+FW_SUPPORT_PRIVACY_DISPLAY_FOR_APPLOCK, FW_PRIVACY_DISPLAY_*) to true at build time, not from the
+phone's floating features, so every phone running it took the feature's paths (window manager,
+display, transitions, app lock) against a panel that has none. They are set false at the end of
+CoreRune's static initializer, before anything reads them (framework and services read them with
+sget; nothing has them inlined).
+
+Usage: oneui_no_privacy_display.py <apktool -r dir of framework.jar>
+Prints the smali_* directory it changed; nothing (and "not present" on stderr) without the flags.
+"""
+import os
+import re
+import sys
+
+CLASS = "Lcom/samsung/android/rune/CoreRune;"
+FIELD = re.compile(r"^\.field public static final [^\n]*?\b(FW_(?:PARTIAL_|SUPPORT_)?PRIVACY_DISPLAY[A-Z_]*):Z$", re.M)
+MARK = "    # OneOS: Privacy Display off (oneui_no_privacy_display.py)\n"
+
+
+def main(root):
+    for d, _, fs in os.walk(root):
+        if "CoreRune.smali" not in fs:
+            continue
+        p = os.path.join(d, "CoreRune.smali")
+        t = open(p, errors="replace").read()
+        if not t.split("\n", 1)[0].endswith(" " + CLASS):
+            continue
+        fields = FIELD.findall(t)
+        if not fields:
+            break
+        if MARK in t:
+            print(os.path.relpath(p, root).split(os.sep)[0])
+            return
+        m = re.search(r"^\.method static constructor [^\n]*<clinit>\(\)V\n(.*?)^\.end method", t, re.M | re.S)
+        if not m:
+            sys.exit(f"{p}: no static initializer; not patched")
+        body = m.group(1)
+        if body.count("return-void") != 1:
+            sys.exit(f"{p}: <clinit> returns {body.count('return-void')} times; not patched")
+        add = MARK + "    const/4 v0, 0x0\n" + "".join(f"    sput-boolean v0, {CLASS}->{f}:Z\n" for f in fields) + "\n"
+        body = body.replace("    return-void", add + "    return-void")
+        t = t[:m.start(1)] + body + t[m.end(1):]
+        open(p, "w").write(t)
+        print(os.path.relpath(p, root).split(os.sep)[0])
+        print(f"Privacy Display off: {' '.join(fields)}", file=sys.stderr)
+        return
+    print("not present", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
diff --git a/switcher/patches/oneui_privacy_display_controller_always.py b/switcher/patches/oneui_privacy_display_controller_always.py
new file mode 100644
index 0000000..c72aab5
--- /dev/null
+++ b/switcher/patches/oneui_privacy_display_controller_always.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""One UI 9.5 set r5: WindowManagerService always makes its PrivacyDisplayController.
+
+Set r2 turned CoreRune's FW_PRIVACY_DISPLAY flags off (oneui_no_privacy_display.py), and
+WindowManagerService's constructor makes the controller only under that flag. Fourteen classes of
+services.jar use WindowManagerServiceExt.mPrivacyDisplayController; r3 null-checked the four binder
+calls in WindowManagerService (oneui_privacy_display_null_safe.py), but others read it unguarded:
+Transition.collectVisibleChange read mPrivacyDisplayApplied on null at a display configuration change,
+"FATAL EXCEPTION IN SYSTEM PROCESS: android.display", and One UI 9.5's system died 1 to 6 minutes in
+(11-19 reports d972589b S23 on 0.5.25, b978fbbd A26, 81846c57 S23 Ultra).
+
+The controller is made whatever the flag says: the S26 Ultra's own object, idle with every Privacy
+Display flag off (nothing turns it on), and each of those reads gets "not applied". Fail-closed: the
+flag read must be found exactly once, right before the controller's new-instance, else exit 1.
+
+    oneui_privacy_display_controller_always.py <services smali dir>   -> prints the smali dir it changed
+"""
+import os
+import re
+import sys
+
+CLS = "com/android/server/wm/WindowManagerService.smali"
+MARK = "# OneOS: PrivacyDisplayController made whatever FW_PRIVACY_DISPLAY says"
+GATE = re.compile(
+    r"^( *)sget-boolean (v\d+), Lcom/samsung/android/rune/CoreRune;->FW_PRIVACY_DISPLAY:Z\n"
+    r"(\s*)if-eqz \2, (:cond_\w+)\n"
+    r"(\s*)new-instance v\d+, Lcom/android/server/wm/PrivacyDisplayController;\n", re.M)
+
+
+def main():
+    root = sys.argv[1]
+    hits = [d for d in sorted(os.listdir(root)) if d.startswith("smali") and os.path.isfile(os.path.join(root, d, CLS))]
+    if len(hits) != 1:
+        sys.exit(f"oneui_privacy_display_controller_always: {CLS} found in {hits or 'no smali dir'}")
+    path = os.path.join(root, hits[0], CLS)
+    src = open(path).read()
+    if MARK in src:
+        print(hits[0])
+        return
+    found = list(GATE.finditer(src))
+    if len(found) != 1:
+        sys.exit(f"oneui_privacy_display_controller_always: the controller's flag gate found {len(found)} times")
+    m = found[0]
+    ind, reg = m.group(1), m.group(2)
+    flag = m.group(0).splitlines(True)[0]
+    src = src[:m.start()] + f"{ind}{MARK}\n{ind}const/4 {reg}, 0x1\n" + src[m.start() + len(flag):]
+    with open(path, "w") as f:
+        f.write(src)
+    print(hits[0])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/switcher/patches/oneui_privacy_display_null_safe.py b/switcher/patches/oneui_privacy_display_null_safe.py
new file mode 100644
index 0000000..216a7fa
--- /dev/null
+++ b/switcher/patches/oneui_privacy_display_null_safe.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+"""One UI 9.5 set r3: WindowManagerService's Privacy Display calls without a controller.
+
+Set r2 (oneui_no_privacy_display.py) turned CoreRune's FW_PRIVACY_DISPLAY flags off, so
+WindowManagerServiceExt.mPrivacyDisplayController is never made. SystemUI keeps its own Privacy
+Display screens and still asks: IWindowManager.getPrivacyDisplayCustomAppList threw
+NullPointerException (the getClass() null check after the iget) into SystemUI's
+ScreenPrivacyDetailViewModel, which crashed it every 3 s on every phone but the S26 Ultra
+(11-19 reports on A16, A17, S23, S23 Ultra: 8 to 94 crashes a session).
+
+The binder calls SystemUI and Settings can make get a null check right after the controller is
+read: the app list returns an empty ArrayList, the others return. Fail-closed: every method must be
+found with exactly one read of the controller, else exit 1.
+
+    oneui_privacy_display_null_safe.py <services smali dir>   -> prints the smali dir it changed
+"""
+import os
+import re
+import sys
+
+CLS = "com/android/server/wm/WindowManagerService.smali"
+READ = "Lcom/android/server/wm/WindowManagerServiceExt;->mPrivacyDisplayController:Lcom/android/server/wm/PrivacyDisplayController;"
+METHODS = {
+    "getPrivacyDisplayCustomAppList(I)Ljava/util/List;": "list",
+    "requestPrivacyDisplayEnable(ZLjava/lang/String;)V": "void",
+    "resetAllPrivacyDisplaySettings()V": "void",
+    "setPrivacyDisplayPolicy(ILjava/lang/String;I)V": "void",
+}
+MARK = "# OneOS: no Privacy Display controller"
+
+
+def main():
+    root = sys.argv[1]
+    hits = [d for d in sorted(os.listdir(root)) if d.startswith("smali") and os.path.isfile(os.path.join(root, d, CLS))]
+    if len(hits) != 1:
+        sys.exit(f"oneui_privacy_display_null_safe: {CLS} found in {hits or 'no smali dir'}")
+    path = os.path.join(root, hits[0], CLS)
+    src = open(path).read()
+    if MARK in src:
+        print(hits[0])
+        return
+    for sig, kind in METHODS.items():
+        m = re.search(r"^\.method [^\n]*" + re.escape(sig) + r"\n(.*?)^\.end method", src, re.M | re.S)
+        if not m:
+            sys.exit(f"oneui_privacy_display_null_safe: {sig} not found")
+        body = m.group(1)
+        reads = list(re.finditer(r"^( *)iget-object ([vp]\d+), [vp]\d+, " + re.escape(READ) + r"\n", body, re.M))
+        if len(reads) != 1:
+            sys.exit(f"oneui_privacy_display_null_safe: {sig} reads the controller {len(reads)} times")
+        r = reads[0]
+        ind, reg = r.group(1), r.group(2)
+        label = ":oneos_pd_" + sig.split("(")[0]
+        if kind == "list":
+            loc = re.search(r"^ *\.locals (\d+)", body, re.M)
+            if not loc or int(loc.group(1)) < 1:
+                sys.exit(f"oneui_privacy_display_null_safe: {sig} has no local register")
+            ret = (f"{ind}new-instance v0, Ljava/util/ArrayList;\n{ind}invoke-direct {{v0}}, Ljava/util/ArrayList;-><init>()V\n"
+                   f"{ind}return-object v0\n")
+        else:
+            ret = f"{ind}return-void\n"
+        guard = f"{r.group(0)}\n{ind}{MARK}\n{ind}if-nez {reg}, {label}\n\n{ret}\n{ind}{label}\n"
+        body = body[:r.start()] + guard + body[r.end():]
+        src = src[:m.start(1)] + body + src[m.end(1):]
+    with open(path, "w") as f:
+        f.write(src)
+    print(hits[0])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/switcher/patches/oneui_vaultkeeper_unreachable.py b/switcher/patches/oneui_vaultkeeper_unreachable.py
new file mode 100755
index 0000000..4cc770a
--- /dev/null
+++ b/switcher/patches/oneui_vaultkeeper_unreachable.py
@@ -0,0 +1,67 @@
+#!/usr/bin/env python3
+"""One UI 9.5 set r6: VaultKeeperService off when the ISehVaultKeeper HAL is not there for the guest.
+
+DmcService's onBootPhase(PHASE_BOOT_COMPLETED) calls VaultKeeperManager (destroy, write), which reaches
+VaultKeeperService's native library, and lib vkjni waits for the AIDL HAL
+vendor.samsung.hardware.security.vaultkeeper.ISehVaultKeeper/default with no time limit. In the guest
+nothing serves that instance, so the boot phase never finished: SystemServer's boot-phase thread logged
+"Waited one second for ...ISehVaultKeeper/default" every second after "DmcService$Lifecycle:
+PHASE_BOOT_COMPLETED", ActivityManagerService.finishBooting waited on it, Samsung's setup wizard stayed
+on SetupWizardPreActionActivity (11-19 reports e8527bc3, 9a0d3d37, 6e473bba: S23 family) and the
+watchdog killed system_server after 68 s on the display thread (f82d7be8).
+
+VaultKeeperService already has an unsupported state: mServiceSupport 0 (from nativeGetSystemSolution),
+and every method that reaches the HAL checks it first and returns "VaultKeeper not support" at once.
+The constructor gets a check after that assignment: when servicemanager has no such service right now
+(ServiceManager.checkService, which neither waits nor starts a lazy service), mServiceSupport is 0.
+Where the HAL is registered, nothing changes. Fail-closed: the assignment must be found exactly once.
+
+    oneui_vaultkeeper_unreachable.py <services smali dir>   -> prints the smali dir it changed
+"""
+import os
+import re
+import sys
+
+CLS = "com/android/server/VaultKeeperService.smali"
+FIELD = "Lcom/android/server/VaultKeeperService;->mServiceSupport:I"
+INSTANCE = "vendor.samsung.hardware.security.vaultkeeper.ISehVaultKeeper/default"
+MARK = "    # OneOS: VaultKeeper unsupported without its HAL (oneui_vaultkeeper_unreachable.py)\n"
+ASSIGN = re.compile(r"^    invoke-direct \{p0\}, Lcom/android/server/VaultKeeperService;->nativeGetSystemSolution\(\)I\n"
+                    r"\n?    move-result (v\d+)\n\n?"
+                    r"    iput \1, p0, " + re.escape(FIELD) + r"\n", re.M)
+
+
+def main():
+    root = sys.argv[1]
+    hits = [d for d in sorted(os.listdir(root)) if d.startswith("smali") and os.path.isfile(os.path.join(root, d, CLS))]
+    if not hits:
+        print("oneui_vaultkeeper_unreachable: not present", file=sys.stderr)
+        return
+    if len(hits) != 1:
+        sys.exit(f"oneui_vaultkeeper_unreachable: {CLS} found in {hits}")
+    path = os.path.join(root, hits[0], CLS)
+    src = open(path).read()
+    if MARK in src:
+        print(hits[0])
+        return
+    found = list(ASSIGN.finditer(src))
+    if len(found) != 1:
+        sys.exit(f"oneui_vaultkeeper_unreachable: the mServiceSupport assignment found {len(found)} times")
+    m = found[0]
+    reg = m.group(1)
+    add = (MARK +
+           f"    const-string {reg}, \"{INSTANCE}\"\n\n"
+           f"    invoke-static {{{reg}}}, Landroid/os/ServiceManager;->checkService(Ljava/lang/String;)Landroid/os/IBinder;\n\n"
+           f"    move-result-object {reg}\n\n"
+           f"    if-nez {reg}, :oneos_vk_hal_there\n\n"
+           f"    const/4 {reg}, 0x0\n\n"
+           f"    iput {reg}, p0, {FIELD}\n\n"
+           f"    :oneos_vk_hal_there\n")
+    src = src[:m.end()] + add + src[m.end():]
+    with open(path, "w") as f:
+        f.write(src)
+    print(hits[0])
+
+
+if __name__ == "__main__":
+    main()
diff --git a/switcher/patches/pixel_camera_abi.py b/switcher/patches/pixel_camera_abi.py
index e375532..920b2cc 100644
