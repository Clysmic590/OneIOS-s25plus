+      *slot = v;
+      if (d->valid && d->shown[(size_t)row * XHD_TILES + t] == v) continue;
+      if (x < x0) x0 = x;
+      if (x + w > x1) x1 = x + w;
+      if (row < y0) y0 = row;
+      y1 = row + 1;
+    }
+  if (y0 != UINT32_MAX) *dirty = (struct xhd_rect){ x0, y0, x1 - x0, y1 - y0 };
+  return 0;
+}
+
+void xhd_damage_commit(struct xhd_damage *d)
+{
+  uint64_t *t = d->shown;
+  d->shown = d->next; d->next = t;
+  d->valid = 1;
+}
