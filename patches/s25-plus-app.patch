@@ -0,0 +1,75 @@
+package com.fahadali.oneos.session
+
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.util.AtomicFile
+import com.fahadali.oneos.BuildConfig
+import com.fahadali.oneos.core.model.OneiosToolFlow
+import java.io.File
+import java.io.IOException
+import java.time.Instant
+
+/** The most recent failed tool run. The app saves this privately until the user exports it. */
+internal object OneiosFailureReport {
+    private const val OUTPUT_LIMIT = 256 * 1024
+
+    private fun file(context: Context) = AtomicFile(File(context.filesDir, "oneios-last-failure.txt"))
+
+    fun available(context: Context): Boolean = runCatching {
+        file(context).openRead().use { true }
+    }.getOrDefault(false)
+
+    fun save(context: Context, flow: OneiosToolJob.Flow, state: OneiosToolJob.State) {
+        val view = state.view
+        if (state.problem == null && state.refusals.isEmpty() &&
+            view.end !in setOf(OneiosToolFlow.End.REFUSED, OneiosToolFlow.End.FAILED, OneiosToolFlow.End.LOST)
+        ) return
+        val report = buildString {
+            appendLine("OneiOS failure report")
+            appendLine("Time: ${Instant.now()}")
+            appendLine("OneOS: ${BuildConfig.VERSION_NAME}")
+            appendLine("Device: ${Build.MODEL} (${Build.DEVICE}), Android ${Build.VERSION.RELEASE}, ${Build.ID}")
+            appendLine("Operation: ${flow.name}")
+            state.toolVersion?.let { appendLine("Tool: $it") }
+            flow.requests.getOrNull(state.request - 1)?.let { appendLine("Request: ${it.cmd}") }
+            view.end?.let { appendLine("Result: $it") }
+            view.code?.let { appendLine("Error code: $it") }
+            state.problem?.let { appendLine("App: $it") }
+            view.text?.let { appendLine("Tool: $it") }
+            view.spaceNeed?.let { appendLine("Space needed: $it bytes") }
+            view.spaceFree?.let { appendLine("Space available: $it bytes") }
+            when (view.code) {
+                "prepared-inputs" -> appendLine("Diagnosis: a required prepared image input is missing or invalid. See the tool error for the input path.")
+                "space" -> appendLine("Diagnosis: the device has insufficient free space for this step.")
+                "mismatch" -> appendLine("Diagnosis: a file differs from the value recorded by the runtime or image profile.")
+                "unknown", "not-ported" -> appendLine("Diagnosis: the installed runtime does not implement this step.")
+            }
+            view.steps.forEach { appendLine("Step ${it.id}: ${it.state}") }
+            state.refusals.forEach { appendLine("Request error: $it") }
+            if (view.lines.isNotEmpty()) {
+                appendLine()
+                appendLine("Recent output")
+                val output = view.lines.takeLast(200).joinToString("\n") { it.takeLast(2048) }
+                if (output.length > OUTPUT_LIMIT) appendLine("[Older output omitted]")
+                appendLine(output.takeLast(OUTPUT_LIMIT))
+            }
+        }
+        val destination = file(context)
+        val stream = destination.startWrite()
+        try {
+            stream.write(report.toByteArray(Charsets.UTF_8))
+            destination.finishWrite(stream)
+        } catch (e: IOException) {
+            destination.failWrite(stream)
+            throw e
+        }
+    }
+
+    fun export(context: Context, uri: Uri) {
+        file(context).openRead().use { input ->
+            val output = context.contentResolver.openOutputStream(uri, "wt") ?: throw IOException("Cannot open export destination")
+            output.use { input.copyTo(it) }
+        }
+    }
+}

