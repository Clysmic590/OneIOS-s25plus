index 9d341db..28929ff 100644
--- a/app-android/app/src/full/assets/root/oneios_root.sh
+++ b/app-android/app/src/full/assets/root/oneios_root.sh
@@ -541,6 +541,45 @@ do_check() {
     kill "$dog" 2>/dev/null
     timed=0
     [ ! -e "$CHECKS/timeout" ] || timed=1
+    # Keep the phone-specific evidence beside the hardware-check output. The
+    # GPU test can fault in the renderer after a successful import/bind, and
+    # Bluetooth may expose AIDL rather than the HIDL service the bridge asks
+    # for. These reads happen only after a failed check and never change state.
+    if [ $timed = 0 ] && [ "$id" = gpu ] && [ "$rc" -gt 128 ]; then
+        sleep 1
+        {
+            echo "--- GPU crash details (gpuctl only) ---"
+            timeout 5 logcat -b crash -d -t 1200 2>&1 | grep -i -B8 -A32 -E 'gpuctl|SIGSEGV' | tail -120
+            for d in /data/tombstones /data/vendor/tombstones; do
+                for f in "$d"/tombstone_*; do
+                    [ -f "$f" ] || continue
+                    grep -q -E 'Cmdline:.*gpuctl|name: gpuctl' "$f" || continue
+                    echo "--- $f ---"
+                    grep -n -E -B3 -A18 'Cmdline:|name: gpuctl|signal 11|SIGSEGV|backtrace:|#[0-9]+' "$f" | head -160
+                done
+            done
+        } >> "$log" 2>&1
+    fi
+    if [ $timed = 0 ] && [ "$id" = bt ] && [ "$rc" -ne 0 ]; then
+        {
+            echo "--- Bluetooth service discovery ---"
+            echo "HIDL services:"
+            if command -v lshal >/dev/null 2>&1; then
+                timeout 8 lshal 2>&1 | grep -i -E 'bluetooth|IBluetoothHci' | head -40
+            else
+                echo "lshal unavailable"
+            fi
+            echo "AIDL services:"
+            timeout 8 service list 2>&1 | grep -i -E 'bluetooth|IBluetoothHci' | head -40
+            echo "Vendor VINTF declarations:"
+            for f in /vendor/etc/vintf/manifest.xml /vendor/etc/vintf/manifest/*.xml /vendor/etc/vintf/*.xml; do
+                [ -r "$f" ] || continue
+                grep -qi bluetooth "$f" || continue
+                echo "--- $f ---"
+                grep -i -B2 -A8 bluetooth "$f" | head -30
+            done
+        } >> "$log" 2>&1
+    fi
     head -c 262144 "$log" | sed 's/^/| /'
     if [ $timed = 1 ]; then
         check_restore "$id"

