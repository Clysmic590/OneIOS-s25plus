+/// A fetch writes the record after each member, so the record alone does not mean the download finished.
+pub fn inputs_complete(profile_path: &str, indir: &str) -> Result<bool, Fail> {
+    let profile = profile::load_profile(profile_path)?;
+    let record = load_record(&py::join(indir, "inputs.json"), &profile)?;
+    let members = record.get("members");
+    Ok(profile.members().iter().all(|member| {
+        let path = text(member, "path");
+        let out = py::join(indir, py::basename(path));
+        let Some(entry) = members.and_then(|entries| entries.get(text(member, "role"))) else { return false };
+        entry.get("member") == member.get("path") && entry.get("crc32") == member.get("crc32") &&
+            (decrypted_is_there(member, &record, indir, &out) ||
+                std::fs::symlink_metadata(out).is_ok_and(|m| m.is_file() && Some(m.len()) == member.get("size").and_then(Value::as_u64)))
+    }))
+}
