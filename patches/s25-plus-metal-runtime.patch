+fn make_image(rq: &Rq) -> Result<Done, Fail> {
+    use oneios_image::assemble;
+    let indir = rq.write_path("indir")?;
+    let work = rq.write_path("work")?;
+    let out = rq.write_path("out")?;
+    let sums = rq.write_path("sums_list")?;
+    let ids = rq.write_path("ids_list")?;
+    rq.req.done()?;
+    let stage = Path::new(&rq.cx.stage);
+    for (path, required) in [
+        (&indir, "make/inputs"), (&work, "make"), (&out, "image.new"),
+        (&sums, "image.new.sha256"), (&ids, "image.new.ids"),
+    ] {
+        if Path::new(path) != stage.join(required) {
+            return Err(Fail::usage(format!("make-image: expected stage path {required}")));
+        }
+    }
+    let prepared = stage.join("make/prepared");
+    let profile = stage.join("runtime/lib/profiles/ios-27.0.1-iPhone18-2.toml");
+    rq.cx.may_write(prepared.to_str().ok_or_else(|| Fail::usage("Invalid prepared path"))?)
+        .map_err(|why| Fail::refused("outside", why))?;
+    let out_dir = Path::new(&out);
+    if std::fs::read_dir(out_dir).map_err(|e| io(&out, e))?.next().is_some() {
+        return Err(Fail::refused("exists", "image.new is not empty; start a new staging operation"));
+    }
+    let prepared_kernel = prepared.join("kernel.kc").is_file();
+    let can_prelink = stage.join("runtime/kernel/xnu.macho").is_file() && stage.join("runtime/lib/prelink").is_dir();
+    let prepared_seed = prepared.join("data.seed").is_file();
+    let can_pack_seed = prepared.join("tweaked-data").is_dir() &&
+        prepared.join("data.meta.json").is_file() && prepared.join("owners.tsv").is_file();
+    let mut missing = Vec::new();
+    if !prepared_kernel && !can_prelink { missing.push("a kernel collection (kernel.kc)"); }
+    if !prepared_seed && !can_pack_seed { missing.push("a Data seed (data.seed)"); }
+    if !missing.is_empty() {
+        return Err(Fail::refused("prepared-inputs", format!(
+            "Make iOS image needs {} prepared on a PC in make/prepared. To install a finished image, use iOS image set → I have the file.",
+            missing.join(" and ")
+        )));
+    }
+    let helper = stage.join("runtime/bin/oneios-aea");
+    if helper.exists() {
+        let expected = std::fs::read_to_string(stage.join("runtime.sha256")).map_err(|e| io("runtime.sha256", e))?;
+        let want = expected.lines().filter_map(|line| line.split_once("  "))
+            .find_map(|(sha, path)| (path == "bin/oneios-aea").then_some(sha));
+        if want != Some(oneios_image::sha256_of(&helper.to_string_lossy()).map_err(image_fail)?.as_str()) {
+            return Err(Fail::refused("mismatch", "The AEA helper does not match the staged runtime"));
+        }
+    }
+    if !oneios_image::inputs_complete(&profile.to_string_lossy(), &indir).map_err(image_fail)? {
+        job::step("directory");
+        oneios_image::fetch(&profile.to_string_lossy(), &indir, 4, None, None, true).map_err(image_fail)?;
+    }
+    if helper.exists() {
+        let scratch = out_dir.join("decrypt");
+        std::fs::create_dir(&scratch).map_err(|e| io("decrypt work folder", e))?;
+        let guard = job::temp(scratch);
+        job::step("decrypt");
+        assemble::decrypt_members(&profile.to_string_lossy(), Path::new(&indir), &helper, guard.path())
+            .map_err(image_fail)?;
+    }
+    let kernel_work = if !prepared_kernel {
+        let scratch = out_dir.join("prelink");
+        std::fs::create_dir(&scratch).map_err(|e| io("prelink work folder", e))?;
+        let guard = job::temp(scratch);
+        let kernel = build_image_kernel(rq, stage, &profile, Path::new(&indir), guard.path())?;
+        Some((guard, kernel))
+    } else {
+        None
+    };
+    let seed_work = if !prepared_seed {
+        let scratch = out_dir.join("seed");
+        std::fs::create_dir(&scratch).map_err(|e| io("seed work folder", e))?;
+        let guard = job::temp(scratch);
+        let seed = build_image_seed(&profile, Path::new(&indir), &prepared, guard.path())?;
+        Some((guard, seed))
+    } else {
+        None
+    };
+    let inputs = assemble::Prepared::open(&profile.to_string_lossy(), Path::new(&indir), &prepared,
+        kernel_work.as_ref().map(|(_, kernel)| Path::new(kernel)),
+        seed_work.as_ref().map(|(_, seed)| seed.as_path()))
+        .map_err(|e| Fail::refused("prepared-inputs", format!("Make iOS image needs decrypted volumes recorded in inputs.json and a prepared Data seed and kernel collection: {e}")))?;
+    rq.space(out_dir, inputs.bytes.saturating_add(64 << 20))?;
+    let part = format!("{out}.part");
+    rq.cx.may_write(&part).map_err(|why| Fail::refused("outside", why))?;
+    std::fs::create_dir(&part).map_err(|e| io(&part, e))?;
+    let guard = job::temp(&part);
+    let (version, build, format) = inputs.build(guard.path()).map_err(image_fail)?;
+    drop(kernel_work);
+    drop(seed_work);
+    job::step("stage");
+    let files = assemble::files(&part).map_err(image_fail)?;
+    let mut sums_text = String::new();
+    let mut ids_text = String::new();
+    for name in &files {
+        check()?;
+        let path = guard.path().join(name);
+        let sha = oneios_image::sha256_of(&path.to_string_lossy()).map_err(image_fail)?;
+        let m = std::fs::metadata(&path).map_err(|e| io(name, e))?;
+        sums_text.push_str(&format!("{sha}  {name}\n"));
+        ids_text.push_str(&format!("{}:{}:{}:{} {name}\n", m.dev(), m.ino(), m.size(), m.mtime()));
+    }
+    check()?;
+    for (path, text) in [(&sums, sums_text), (&ids, ids_text)] {
+        let mut file = std::fs::OpenOptions::new().write(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(path).map_err(|e| io(path, e))?;
+        if !file.metadata().map_err(|e| io(path, e))?.is_file() {
+            return Err(Fail::refused("outside", format!("{path}: expected a regular staging list")));
+        }
+        file.set_len(0).and_then(|_| file.write_all(text.as_bytes())).map_err(|e| io(path, e))?;
+    }
+    std::fs::rename(guard.path(), out_dir).map_err(|e| io(&out, e))?;
+    guard.keep();
+    Ok(Done::new(format!("Verified {files_count} image files for iOS {version}", files_count = files.len()))
+        .f("files", files.len()).f("format", format).f("version", version).f("build", build))
+}
+
+fn build_image_seed(profile: &Path, inputs: &Path, prepared: &Path, scratch: &Path) -> Result<std::path::PathBuf, Fail> {
+    let (image, epoch) = oneios_image::assemble::seed_input(&profile.to_string_lossy(), inputs).map_err(image_fail)?;
+    let cache = scratch.join("launchd.plist");
+    job::step("seed");
+    oneios_image::apfs_tools::copy_to(&image.to_string_lossy(), "System/Library/xpc/launchd.plist",
+        &cache.to_string_lossy(), None, Pick::Block0).map_err(image_fail)?;
+    oneios_image::assemble::pack_seed_with_overrides(prepared, scratch, epoch, |existing| {
+        crate::launchd::overrides(&cache, existing, &[]).map(|overrides| overrides.bytes)
+    }).map_err(image_fail)
+}
+
+fn build_image_kernel(rq: &Rq, stage: &Path, profile: &Path, inputs: &Path, out: &Path) -> Result<String, Fail> {
+    use oneios_prelink::build;
+    let native = stage.join("runtime/kernel/xnu.macho");
+    if !native.is_file() {
+        return Err(Fail::refused("not-found", "This runtime does not carry a hosted XNU kernel for prelinking"));
+    }
+    let config = stage.join("runtime/lib/prelink");
+    let mut reviewed = Vec::new();
+    for entry in std::fs::read_dir(config.join("reviewed")).map_err(|e| io("reviewed prelink records", e))? {
+        let entry = entry.map_err(|e| io("reviewed prelink record", e))?;
+        if entry.path().extension().is_some_and(|ext| ext == "json") {
+            reviewed.push(entry.path().to_string_lossy().into_owned());
+        }
+    }
+    reviewed.sort_unstable();
+    let cache = oneios_image::assemble::kernelcache(&profile.to_string_lossy(), inputs).map_err(image_fail)?;
+    let decoded = out.join("kernelcache.macho").to_string_lossy().into_owned();
+    rq.space(out, 2 << 30)?;
+    check()?;
+    job::step("kernel");
+    oneios_image::im4p::cmd(&cache.to_string_lossy(), &decoded).map_err(image_fail)?;
+    let args = build::Args {
+        kernel: native.to_string_lossy().into_owned(),
+        kernelcache: decoded,
+        profile: config.join("profile.toml").to_string_lossy().into_owned(),
+        reviewed: config.join("reviewed-24A446-v54.json").to_string_lossy().into_owned(),
+        more_reviewed: reviewed,
+        pairs: config.join("pairs-24A446.json").to_string_lossy().into_owned(),
+        stubs: config.join("stubs-24A446.json").to_string_lossy().into_owned(),
+        xnuprelink: config.join("xnuprelink").to_string_lossy().into_owned(),
+        reference: None,
+        out: out.to_string_lossy().into_owned(),
+        repo: None,
+        no_git: true,
+        oneios_commit: None,
+        xnuprelink_commit: None,
+        remove_work: true,
+    };
+    let built = build::build(&args).map_err(|e| Fail::failed(format!("{e:#}")))?;
+    Ok(built.kc)
+}
+
+fn launchd_overrides(rq: &Rq) -> Result<Done, Fail> {
+    let cache = rq.existing("cache")?;
+    let existing = rq.req.opt_str("existing")?.map(|_| rq.existing("existing")).transpose()?;
+    let jetsam = rq.req.list("jetsam")?;
+    for path in &jetsam {
+        crate::plain_path(path).map_err(Fail::usage)?;
+    }
+    let out = rq.write_path("out")?;
+    rq.req.done()?;
+    let part = format!("{out}.part");
+    rq.cx.may_write(&part).map_err(|why| Fail::refused("outside", why))?;
+    fresh(&out)?;
+    job::step("policy");
+    let policy = crate::launchd::overrides(Path::new(&cache), existing.as_deref().map(Path::new), &jetsam)
+        .map_err(Fail::failed)?;
+    check()?;
+    std::fs::create_dir(&part).map_err(|e| io(&part, e))?;
+    let guard = job::temp(&part);
+    let dir = guard.path();
+    let overrides = dir.join("disabled.plist");
+    let marker = dir.join("disabled.migrated");
+    std::fs::write(&overrides, policy.bytes).map_err(|e| io("disabled.plist", e))?;
+    std::fs::write(&marker, []).map_err(|e| io("disabled.migrated", e))?;
+    for path in [&overrides, &marker] {
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o644))
