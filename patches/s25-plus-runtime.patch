+)
+
+func appleURL(u *url.URL) bool {
+	host := strings.ToLower(u.Hostname())
+	return u.Scheme == "https" && u.User == nil &&
+		(u.Port() == "" || u.Port() == "443") &&
+		(host == "apple.com" || strings.HasSuffix(host, ".apple.com"))
+}
+
+func decrypt(input, output string) error {
+	metadata, err := aea.Info(input)
+	if err != nil {
+		return err
+	}
+	keyURL, err := url.Parse(string(metadata["com.apple.wkms.fcs-key-url"]))
+	if err != nil || !appleURL(keyURL) {
+		return fmt.Errorf("expected an HTTPS Apple firmware key URL")
+	}
+	client := &http.Client{
+		Timeout: 30 * time.Second,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if len(via) >= 5 || !appleURL(req.URL) {
+				return fmt.Errorf("refused firmware key redirect")
+			}
+			return nil
+		},
+	}
+	response, err := client.Get(keyURL.String())
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("Apple key service returned %s", response.Status)
+	}
+	const limit = 32 << 10
+	key, err := io.ReadAll(io.LimitReader(response.Body, limit+1))
+	if err != nil {
+		return err
+	}
+	if len(key) == 0 || len(key) > limit {
+		return fmt.Errorf("Apple key service returned an invalid response size")
+	}
+	_, err = aea.Decrypt(&aea.DecryptConfig{Input: input, Output: output, PrivKeyData: key})
+	return err
+}
+
+func main() {
+	if len(os.Args) != 3 || !strings.HasSuffix(os.Args[1], ".aea") {
+		fmt.Fprintln(os.Stderr, "usage: oneios-aea INPUT.aea OUTPUT_DIRECTORY")
+		os.Exit(2)
+	}
+	if err := decrypt(os.Args[1], os.Args[2]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
diff --git a/tools/oneios-tool/crates/oneios-image/src/assemble.rs b/tools/oneios-tool/crates/oneios-image/src/assemble.rs
new file mode 100644
--- /dev/null
+++ b/tools/oneios-tool/crates/oneios-image/src/assemble.rs
@@ -0,0 +1,276 @@
+//! Assemble an image set from the verified fetch and prepared build outputs.
+
+use crate::{err, ipsw, manifest, profile, Fail};
+use oneios_common::{job, pyjson};
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::Path;
+
+pub struct Prepared {
+    profile: profile::Profile,
+    record: pyjson::Value,
+    files: Vec<(std::path::PathBuf, String, Option<String>)>,
+    pub bytes: u64,
+}
+
+impl Prepared {
+    pub fn open(profile_path: &str, inputs: &Path, build: &Path, kernel: Option<&Path>, seed: Option<&Path>) -> Result<Self, Fail> {
+        let profile = profile::load_profile(profile_path)?;
+        let record_path = inputs.join("inputs.json");
+        let record = pyjson::load(&record_path).map_err(|e| err!("{}: {e}", record_path.display()))?;
+        if record.get("build").and_then(pyjson::Value::as_str) != Some(profile.text("os", "build")) {
+            return Err(err!("{}: the fetch record is for another build", record_path.display()));
+        }
+        let mut files = Vec::new();
+        let mut bytes = 0u64;
+        let names = profile.table("image").get("files").and_then(pyjson::Value::as_dict).ok_or(Fail::Usage)?;
+        for (role, name) in names {
+            let member = profile.member_of(role).ok_or(Fail::Usage)?;
+            let name = name.as_str().ok_or(Fail::Usage)?;
+            let source = inputs.join(profile::input_name(member));
+            let encrypted = member.get("aea").and_then(pyjson::Value::as_bool) == Some(true);
+            let rec = record.get("members").and_then(|members| members.get(role));
+            let expected = if encrypted {
+                rec.and_then(|r| r.get("plain_sha256")).and_then(pyjson::Value::as_str)
+            } else {
+                member.get("sha384").or_else(|| member.get("sha256")).and_then(pyjson::Value::as_str)
+            };
+            let expected = expected.ok_or_else(|| err!("{role}: missing verified input digest"))?;
+            bytes = bytes.saturating_add(file_size(&source)?);
+            files.push((source, name.to_owned(), Some(expected.to_owned())));
+        }
+        for key in ["kernel", "seed"] {
+            let name = profile.text("image", key);
+            let prepared_file = if key == "kernel" { kernel } else { seed };
+            let source = prepared_file.map(Path::to_owned).unwrap_or_else(|| build.join(name));
+            bytes = bytes.saturating_add(file_size(&source)?);
+            files.push((source, name.to_owned(), None));
+        }
+        let overlay = build.join("overlay");
+        match fs::symlink_metadata(&overlay) {
+            Ok(meta) if meta.is_dir() => collect_overlay(build, &overlay, &mut files, &mut bytes)?,
+            Ok(_) => return Err(err!("{}: expected a directory", overlay.display())),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(e) => return Err(err!("{}: {e}", overlay.display())),
+        }
+        Ok(Self { profile, record, files, bytes })
+    }
+
+    pub fn build(self, out: &Path) -> Result<(String, String, u64), Fail> {
+        job::begin("copy", "bytes", self.bytes);
+        for (source, name, expected) in self.files {
+            let dest = out.join(&name);
+            copy_file(&source, &dest)?;
+            if let Some(expected) = expected {
+                let (sha256, sha384) = ipsw::digest_file(dest.to_str().ok_or(Fail::Usage)?)?;
+                if expected != sha256 && expected != sha384 {
+                    return Err(err!("{}: differs from the verified input", source.display()));
+                }
+            }
+        }
+        job::end();
+        job::step("verify");
+        let out = out.to_str().ok_or(Fail::Usage)?;
+        manifest::make_manifest(&self.profile, out, Some(self.record), None, None)?;
+        manifest::verify_dir(out, false)?;
+        Ok((self.profile.text("os", "version").to_owned(), self.profile.text("os", "build").to_owned(), profile::FORMAT as u64))
+    }
+}
+
+pub fn seed_input(profile_path: &str, inputs: &Path) -> Result<(std::path::PathBuf, i128), Fail> {
+    let profile = profile::load_profile(profile_path)?;
+    let os = profile.member_of("os").ok_or(Fail::Usage)?;
+    let epoch = profile.table("data").get("epoch").and_then(pyjson::Value::as_int).ok_or(Fail::Usage)?;
+    Ok((inputs.join(profile::input_name(os)), epoch))
+}
+
+pub fn pack_seed_with_overrides(
+    prepared: &Path, scratch: &Path, epoch: i128,
+    make_overrides: impl FnOnce(Option<&Path>) -> Result<Vec<u8>, String>,
+) -> Result<std::path::PathBuf, Fail> {
+    let tree = scratch.join("data");
+    let text = |p: &Path| p.to_string_lossy().into_owned();
+    let source = prepared.join("tweaked-data");
+    if !fs::symlink_metadata(&source).is_ok_and(|m| m.is_dir()) {
+        return Err(err!("{}: expected a prepared Data tree", source.display()));
+    }
+    crate::seed::tree_copy(&text(&source), &text(&tree),
+        &text(&scratch.join("copy-meta.json")), None, "")?;
+    let meta = prepared.join("data.meta.json");
+    let rules = prepared.join("owners.tsv");
+    let mut owners = fs::read_to_string(&rules).map_err(|e| err!("{}: {e}", rules.display()))?;
+    let mut folder = tree;
+    for entry in ["db", "com.apple.xpc.launchd"] {
+        folder.push(entry);
+        match fs::symlink_metadata(&folder) {
+            Ok(m) if m.is_dir() => {}
+            Ok(_) => return Err(err!("{}: expected a regular directory", folder.display())),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {
+                fs::create_dir(&folder).map_err(|e| err!("{}: {e}", folder.display()))?;
+            }
+            Err(e) => return Err(err!("{}: {e}", folder.display())),
+        }
+    }
+    let existing = folder.join("disabled.plist");
+    let existing = match fs::symlink_metadata(&existing) {
+        Ok(m) if m.is_file() => Some(existing.as_path()),
+        Ok(_) => return Err(err!("{}: expected a regular plist", existing.display())),
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => None,
+        Err(e) => return Err(err!("{}: {e}", existing.display())),
+    };
+    let overrides = make_overrides(existing).map_err(Fail::Error)?;
+    for (name, contents) in [("disabled.plist", overrides.as_slice()), ("disabled.migrated", &[][..])] {
+        let path = folder.join(name);
+        let mut output = OpenOptions::new().write(true).create(true).truncate(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK).open(&path)
+            .map_err(|e| err!("{}: {e}", path.display()))?;
+        output.write_all(contents).map_err(|e| err!("{}: {e}", path.display()))?;
+    }
+    owners.push_str("\ndb/com.apple.xpc.launchd\t0\t0\t0755\ndb/com.apple.xpc.launchd/disabled.plist\t0\t0\t0644\ndb/com.apple.xpc.launchd/disabled.migrated\t0\t0\t0644\n");
+    let merged = scratch.join("owners.tsv");
+    fs::write(&merged, owners).map_err(|e| err!("{}: {e}", merged.display()))?;
+    let out = scratch.join("data.seed");
+    crate::seed::seed_pack(&text(&scratch.join("data")), &text(&meta), &text(&out), epoch, Some(&text(&merged)))?;
+    Ok(out)
+}
+
+/// Locate the kernelcache member from the same profile used to fetch it.
+pub fn kernelcache(profile_path: &str, inputs: &Path) -> Result<std::path::PathBuf, Fail> {
+    let profile = profile::load_profile(profile_path)?;
+    let member = profile.member_of("kernelcache").ok_or(Fail::Usage)?;
+    let path = inputs.join(profile::input_name(member));
+    if file_size(&path)? != member.get("size").and_then(pyjson::Value::as_u64).ok_or(Fail::Usage)? {
+        return Err(err!("{}: kernelcache member has the wrong size", path.display()));
+    }
+    Ok(path)
+}
+
+pub fn files(out: &str) -> Result<Vec<String>, Fail> {
+    let mut files = manifest::set_files(out)?;
+    files.push("manifest.json".into());
+    Ok(files)
+}
+
+/// Decrypt only AEA members previously downloaded and recorded by fetch.
+pub fn decrypt_members(
+    profile_path: &str, inputs: &Path, helper: &Path, scratch: &Path,
+) -> Result<(), Fail> {
+    let profile = profile::load_profile(profile_path)?;
+    let record = pyjson::load(inputs.join("inputs.json")).map_err(|e| err!("{e}"))?;
+    if record.get("build").and_then(pyjson::Value::as_str) != Some(profile.text("os", "build")) {
+        return Err(err!("The fetch record is for another iOS build"));
+    }
+    for member in profile.members() {
+        if member.get("aea").and_then(pyjson::Value::as_bool) != Some(true) {
+            continue;
+        }
+        let role = member.get("role").and_then(pyjson::Value::as_str).ok_or(Fail::Usage)?;
+        let name = member.get("path").and_then(pyjson::Value::as_str).ok_or(Fail::Usage)?;
+        let entry = record.get("members").and_then(|entries| entries.get(role))
+            .ok_or_else(|| err!("Fetch has not recorded {role}"))?;
+        let plain_name = profile::input_name(member);
+        let plain = inputs.join(&plain_name);
+        if entry.get("plain_sha256").is_some() && file_size(&plain).is_ok() {
+            continue; // Prepared::build checks the recorded plaintext digest.
+        }
+        let encrypted = inputs.join(crate::py::basename(name));
+        let size = file_size(&encrypted)?;
+        let expected = entry.get("sha256").and_then(pyjson::Value::as_str);
+        if entry.get("member") != member.get("path") || entry.get("crc32") != member.get("crc32")
+            || member.get("size").and_then(pyjson::Value::as_u64) != Some(size)
+            || expected.is_none()
+            || expected != Some(crate::sha256_of(encrypted.to_str().ok_or(Fail::Usage)?)?.as_str())
+        {
+            return Err(err!("{name}: does not match the verified fetch record"));
+        }
+        if let Some(space) = crate::apfs_tools::SPACE_CHECK.get() {
+            space(scratch, size.saturating_mul(2))?;
+        }
+        let folder = scratch.join(role);
+        fs::create_dir(&folder).map_err(|e| err!("{}: {e}", folder.display()))?;
+        let mut child = std::process::Command::new(helper).arg(&encrypted).arg(&folder)
+            .env_clear().env("SSL_CERT_DIR", "/system/etc/security/cacerts")
+            .stdin(std::process::Stdio::null()).spawn()
+            .map_err(|e| err!("{}: {e}", helper.display()))?;
+        let finished = loop {
+            match child.try_wait() {
+                Ok(Some(status)) => break Ok(status),
+                Ok(None) => {}
+                Err(e) => break Err(err!("{e}")),
+            }
+            if let Err(stop) = job::sleep(std::time::Duration::from_millis(150)) {
+                break Err(err!("{stop}"));
+            }
+        };
+        let status = match finished {
+            Ok(status) => status,
+            Err(e) => {
+                let _ = child.kill();
+                let _ = child.wait();
+                return Err(e);
+            }
+        };
+        if !status.success() {
+            return Err(err!("{name}: AEA decryption exited with {status}"));
+        }
+        let output = folder.join(plain_name);
+        file_size(&output)?;
+        crate::apfs::apfs_info(output.to_str().ok_or(Fail::Usage)?)?;
+        job::check().map_err(|stop| err!("{stop}"))?;
+        fs::rename(&output, &plain).map_err(|e| err!("{}: {e}", plain.display()))?;
+        ipsw::record_plain(inputs.to_str().ok_or(Fail::Usage)?, role, plain.to_str().ok_or(Fail::Usage)?)?;
+    }
+    Ok(())
+}
+
+fn file_size(path: &Path) -> Result<u64, Fail> {
+    let meta = fs::symlink_metadata(path).map_err(|e| err!("{}: {e}", path.display()))?;
+    if !meta.is_file() {
+        return Err(err!("{}: expected a regular file", path.display()));
+    }
+    Ok(meta.len())
+}
+
+fn collect_overlay(
+    root: &Path, dir: &Path, files: &mut Vec<(std::path::PathBuf, String, Option<String>)>, bytes: &mut u64,
+) -> Result<(), Fail> {
+    let entries = fs::read_dir(dir).map_err(|e| err!("{}: {e}", dir.display()))?;
+    for entry in entries {
+        job::check().map_err(|stop| err!("{stop}"))?;
+        let entry = entry.map_err(|e| err!("{}: {e}", dir.display()))?;
+        let path = entry.path();
+        let ty = entry.file_type().map_err(|e| err!("{}: {e}", path.display()))?;
+        if ty.is_dir() {
+            collect_overlay(root, &path, files, bytes)?;
+        } else {
+            let name = path.strip_prefix(root).ok().and_then(Path::to_str).ok_or(Fail::Usage)?.to_owned();
+            profile::check_set_path(&name, "overlay file")?;
+            *bytes = bytes.saturating_add(file_size(&path)?);
+            files.push((path, name, None));
+        }
+    }
+    Ok(())
+}
+
+fn copy_file(source: &Path, dest: &Path) -> Result<(), Fail> {
+    let failure = |e: std::io::Error| err!("{} -> {}: {e}", source.display(), dest.display());
+    let mut input = OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(source).map_err(failure)?;
+    if !input.metadata().map_err(failure)?.is_file() {
+        return Err(err!("{}: expected a regular file", source.display()));
+    }
+    fs::create_dir_all(dest.parent().ok_or(Fail::Usage)?).map_err(failure)?;
+    let mut output = File::create_new(dest).map_err(failure)?;
+    let mut buffer = vec![0; 1 << 20];
+    loop {
+        job::check().map_err(|stop| err!("{stop}"))?;
+        let n = input.read(&mut buffer).map_err(failure)?;
+        if n == 0 {
+            break;
+        }
+        output.write_all(&buffer[..n]).map_err(failure)?;
+        job::count(n as u64);
+    }
+    output.set_permissions(fs::Permissions::from_mode(0o644)).map_err(failure)
+}
diff --git a/tools/oneios-tool/crates/oneios-serve/src/launchd.rs b/tools/oneios-tool/crates/oneios-serve/src/launchd.rs
new file mode 100644
--- /dev/null
+++ b/tools/oneios-tool/crates/oneios-serve/src/launchd.rs
@@ -0,0 +1,109 @@
+//! Default launchd policy for the sealed guest layout.
+
+use plist::{Dictionary, Value};
+use std::collections::BTreeSet;
+use std::io::{Cursor, Read};
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+
+const POLICY: &str = include_str!("../../../../../userland/config/daemons.toml");
+const MAX_PLIST_BYTES: u64 = 64 << 20;
+
+pub(crate) struct Overrides {
+    pub bytes: Vec<u8>,
+    pub disabled: Vec<String>,
+    pub force_enabled: Vec<String>,
+}
+
+pub(crate) fn overrides(cache: &Path, existing: Option<&Path>, jetsam: &[String]) -> Result<Overrides, String> {
+    let policy = POLICY.parse::<toml::Table>().map_err(|e| format!("daemons.toml: {e}"))?;
+    let replace = policy.get("replace").and_then(toml::Value::as_table).ok_or("Missing [replace]")?;
+    let mut selected = BTreeSet::new();
+    if replace.get("default").and_then(toml::Value::as_bool).unwrap_or(true) {
+        let labels = replace.get("labels").and_then(toml::Value::as_table).ok_or("Missing [replace.labels]")?;
+        selected.extend(labels.keys().map(String::as_str));
+    }
+    if let Some(groups) = policy.get("group").and_then(toml::Value::as_table) {
+        for group in groups.values() {
+            if group.get("default").and_then(toml::Value::as_bool) != Some(true) {
+                continue;
+            }
+            let labels = group.get("labels").and_then(toml::Value::as_array).ok_or("Missing group labels")?;
+            for label in labels {
+                selected.insert(label.as_str().ok_or("Invalid daemon label")?);
+            }
+        }
+    }
+    let keep = policy.get("keep").and_then(|table| table.get("labels"))
+        .and_then(toml::Value::as_array).ok_or("Missing [keep] labels")?;
+    for label in keep {
+        let label = label.as_str().ok_or("Invalid [keep] label")?;
+        if selected.contains(label) {
+            return Err(format!("daemons.toml: {label} is both kept and disabled"));
+        }
+    }
+    if let Some(idle) = policy.get("idle").and_then(toml::Value::as_table) {
+        for label in idle.keys() {
+            if selected.contains(label.as_str()) {
+                return Err(format!("daemons.toml: {label} is both idled and disabled"));
+            }
+        }
+    }
+
+    let cache = read_dictionary(cache)?;
+    let present: BTreeSet<_> = cache.values()
+        .filter_map(Value::as_dictionary)
+        .flat_map(|group| group.values())
+        .filter_map(Value::as_dictionary)
+        .filter_map(|job| job.get("Label").and_then(Value::as_string))
+        .collect();
+    let mut disabled = match existing {
+        Some(path) => read_dictionary(path)?,
+        None => Dictionary::new(),
+    };
+    let applied: Vec<_> = selected.intersection(&present).map(|label| (*label).to_owned()).collect();
+    let mut forced = BTreeSet::new();
+    for path in jetsam {
+        oneios_common::job::check().map_err(|e| e.to_string())?;
+        let properties = read_dictionary(Path::new(path))?;
+        for version in properties.values().filter_map(Value::as_dictionary) {
+            for kind in ["Daemon", "XPCService"] {
+                let entries = version.get(kind).and_then(Value::as_dictionary)
+                    .and_then(|body| body.get("Override")).and_then(Value::as_dictionary);
+                if let Some(entries) = entries {
+                    forced.extend(applied.iter().filter(|label| {
+                        entries.get(label.as_str()).and_then(Value::as_dictionary)
+                            .and_then(|job| job.get("DisableAllowed")).and_then(Value::as_boolean) == Some(false)
+                    }).cloned());
+                }
+            }
+        }
+    }
+    for label in &applied {
+        disabled.insert(label.clone(), Value::Boolean(true));
+    }
+    disabled.sort_keys();
+    let mut bytes = Vec::new();
+    Value::Dictionary(disabled).to_writer_xml(&mut bytes).map_err(|e| e.to_string())?;
+    Ok(Overrides { bytes, disabled: applied, force_enabled: forced.into_iter().collect() })
+}
+
+fn read_dictionary(path: &Path) -> Result<Dictionary, String> {
+    let read_error = |e: std::io::Error| format!("{}: {e}", path.display());
+    let file = std::fs::OpenOptions::new().read(true).custom_flags(libc::O_NONBLOCK)
+        .open(path).map_err(read_error)?;
+    let metadata = file.metadata().map_err(read_error)?;
+    if !metadata.is_file() || metadata.len() > MAX_PLIST_BYTES {
+        return Err(format!("{}: expected a regular plist file of at most 64 MiB", path.display()));
+    }
+    let mut bytes = Vec::new();
+    file.take(MAX_PLIST_BYTES + 1).read_to_end(&mut bytes).map_err(read_error)?;
+    if bytes.len() as u64 > MAX_PLIST_BYTES {
+        return Err(format!("{}: plist exceeds 64 MiB", path.display()));
+    }
+    match Value::from_reader(Cursor::new(bytes)) {
+        Ok(Value::Dictionary(value)) => Ok(value),
+        Ok(_) => Err(format!("{}: expected a plist dictionary", path.display())),
+        Err(e) => Err(format!("{}: {e}", path.display())),
+    }
+}
