+#!/usr/bin/env bash
+# Build the narrow Android helper against Blacktop's pinned MIT AEA library.
+set -euo pipefail
+root=$(cd "$(dirname "$0")/../.." && pwd)
+out=$(realpath -m "${1:?output path required}")
+cc=${CC_aarch64_linux_android:?set the Android NDK arm64 compiler}
+pin=b2c156960c79b0eefe0885dbb32cce7eef77cf2d
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+git -C "$work" init -q
+git -C "$work" fetch --depth 1 https://github.com/blacktop/ipsw.git "$pin"
+git -C "$work" checkout -q --detach "$pin"
+mkdir "$work/oneios-aea"
+cp "$root/runtime/aea/main.go" "$work/oneios-aea/main.go"
+cd "$work"
+CGO_ENABLED=1 GOOS=android GOARCH=arm64 CC="$cc" go build -mod=readonly -buildmode=pie -trimpath -ldflags='-s -w' -o "$out" ./oneios-aea
+cp LICENSE "$(dirname "$out")/../LICENSE-blacktop-ipsw"
