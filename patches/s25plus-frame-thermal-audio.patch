+static unsigned volume_held, volume_chord;  // the keys can arrive from different evdev devices
+
+static void volume_event(uint16_t code, int32_t value)
+{
+  unsigned key = 1u << (code - KEY_VOLUMEDOWN_);
+  if (value == 1) {
+    volume_held |= key;
+    if (volume_held == 3) volume_chord = 3;
+  } else if (value == 0 && (volume_held & key)) {
+    void (*adjust)(bool) = __atomic_load_n(&xh_input_volume_key, __ATOMIC_ACQUIRE);
+    if (!(volume_chord & key) && adjust) adjust(code == KEY_VOLUMEUP_);
+    volume_held &= ~key;
+    volume_chord &= ~key;
