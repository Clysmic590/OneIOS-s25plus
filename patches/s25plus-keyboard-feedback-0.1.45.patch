   const char *custom_hid[] = { "oneios-hid-queue-kib=128", "hidq_size=32768" };
   for (size_t i = 0; i < sizeof custom_hid / sizeof custom_hid[0]; i++) {
     xh_config_defaults(&c);
@@ -1872,7 +1873,7 @@ static void test_config(const char *dir)
   }
   xh_config_defaults(&c);
   c.s25plus = true;
-  const char *custom_args = "memorystatus_reaper_minimum_age_apps_seconds=120 oneios-hid-queue-kib=128";
