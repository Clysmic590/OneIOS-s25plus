diff --git a/runtime/xnuhost/src/config.c b/runtime/xnuhost/src/config.c
index 7b5f25d..a79c643 100644
--- a/runtime/xnuhost/src/config.c
+++ b/runtime/xnuhost/src/config.c
@@ -379,6 +379,13 @@ int xh_config_finish(xh_config *c)
         !has_switch(c->boot_args, "hidq_size") &&
         sizeof hid_queue <= sizeof c->boot_args - after_reaper)
       memcpy(c->boot_args + after_reaper, hid_queue, sizeof hid_queue);
+
+    // Avoid publishing closed-loop feedback while this guest lacks the haptic
+    // tuning lookup fix. Keyboard feedback can otherwise block on hapticd.
+    static const char actuator_off[] = " oneios-actuator=0";
+    const size_t after_hid = strlen(c->boot_args);
+    if (!has_switch(c->boot_args, "oneios-actuator") && sizeof actuator_off <= sizeof c->boot_args - after_hid)
+      memcpy(c->boot_args + after_hid, actuator_off, sizeof actuator_off);
   }
   if (c->display_direct < 0) c->display_direct = 1;
   if (c->ndisk == 0) { memcpy(c->disk, from_image.disk, sizeof c->disk); c->ndisk = from_image.ndisk; }
