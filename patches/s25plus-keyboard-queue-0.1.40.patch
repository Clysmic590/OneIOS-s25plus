diff --git a/runtime/xnuhost/src/config.c b/runtime/xnuhost/src/config.c
index 6b3ee08..d7fae65 100644
--- a/runtime/xnuhost/src/config.c
+++ b/runtime/xnuhost/src/config.c
@@ -371,6 +371,14 @@ int xh_config_finish(xh_config *c)
     if (!has_switch(c->boot_args, "memorystatus_reaper_minimum_age_apps_seconds") &&
         sizeof reaper_app_age <= sizeof c->boot_args - used)
       memcpy(c->boot_args + used, reaper_app_age, sizeof reaper_app_age);
+
+    // Give queued touch events, including finger lifts, room while backboardd stalls.
+    static const char hid_queue[] = " oneios-hid-queue-kib=256";
+    const size_t after_reaper = strlen(c->boot_args);
+    if (!has_switch(c->boot_args, "oneios-hid-queue-kib") &&
+        !has_switch(c->boot_args, "hidq_size") &&
+        sizeof hid_queue <= sizeof c->boot_args - after_reaper)
+      memcpy(c->boot_args + after_reaper, hid_queue, sizeof hid_queue);
   }
   if (c->display_direct < 0) c->display_direct = 1;
   if (c->ndisk == 0) { memcpy(c->disk, from_image.disk, sizeof c->disk); c->ndisk = from_image.ndisk; }
