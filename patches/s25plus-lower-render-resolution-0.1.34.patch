diff --git a/runtime/xnuhost/src/config.c b/runtime/xnuhost/src/config.c
index 79bc56a..e27f4e0 100644
--- a/runtime/xnuhost/src/config.c
+++ b/runtime/xnuhost/src/config.c
@@ -156,6 +156,7 @@ int xh_config_set(xh_config *c, const char *key, const char *value)
   else if (!strcmp(key, "input-script")) return copy(c->input_script, sizeof c->input_script, value);
   else if (!strcmp(key, "tasks")) return flag(value, &c->tasks);
   else if (!strcmp(key, "task-uid")) c->task_uid = atoi(value);
+  else if (!strcmp(key, "display-render-scale")) { ok = number(value, 2, 3, &c->display_render_scale); }
   else if (!strcmp(key, "display-direct")) { bool on; if (flag(value, &on)) return -1; c->display_direct = on; }
   else if (!strcmp(key, "touch-sleep")) return flag(value, &c->touch_sleep);
   else if (!strcmp(key, "pen")) { ok = !strcmp(value, "auto") || !strcmp(value, "off"); if (ok) strcpy(c->pen, value); }
@@ -309,6 +310,7 @@ int xh_config_finish(xh_config *c)
   if (!c->hz) c->hz = from_image.hz;
   if (!c->display_format) c->display_format = from_image.display_format ? from_image.display_format : XH_PIXELS_BGRX8;
   if (c->display_direct < 0) c->display_direct = from_image.display_direct;
+  if (!c->display_render_scale) c->display_render_scale = from_image.display_render_scale;
   // The KMS back end scans out 32-bit pixels: half floats only go to a display helper (shm) or nowhere.
   if (c->display_format == XH_PIXELS_RGBA16F && !strcmp(c->display, "drm")) { fprintf(stderr, "xnuhost: display-format=rgba16f needs --display shm\n"); return -1; }
   if (!c->scale) c->scale = from_image.scale ? from_image.scale : 3;
@@ -622,6 +624,22 @@ static bool has_switch(const char *args, const char *name)
   return false;
 }
 
+xh_panel_mode xh_display_render_mode(xh_config *c, const xh_panel_mode *panel)
+{
+  xh_panel_mode mode = xh_display_mode(c, panel);
+  // Keep the point size and refresh, and let SurfaceFlinger upscale the smaller backing.
+  // Leave explicit dimensions, boot scales, and configurations without a real panel alone.
+  if (c->display_render_scale == 2 && c->scale == 3 && panel && !c->width && !c->height &&
+      !strcmp(c->mode, "takeover") && !strcmp(c->display, "shm") &&
+      !has_switch(c->boot_args, "offline-legacy-unit-scale") &&
+      mode.width % 3 == 0 && mode.height % 3 == 0 && mode.height >= 1623) {
+    mode.width = mode.width / 3 * 2;
+    mode.height = mode.height / 3 * 2;
+    c->scale = 2;
+  }
+  return mode;
+}
+
 bool xh_boot_args_hides_vmm_from(const char *args, const char *name)
 {
   static const char key[] = "owner-hide-vmm=";
