+++ b/runtime/bridges/thermal/test_thermal.c
@@ -297,6 +297,27 @@ static void test_worker(void)
   br_thermal_close(t);
 }
 
+static void test_early_cap(void)
+{
+  put("/sys/class/power_supply/battery/lrp", "425\n");
+  const br_thermal_options options = { .root = base, .poll_ms = 20, .early_cpu_cap = true };
+  br_thermal *t = br_thermal_open(&options);
+  CHECK(t != NULL);
+  if (!t) return;
+  br_thermal_state state;
+  br_thermal_get(t, &state);
+  CHECK(state.skin_level == BR_THERMAL_MODERATE && state.cap == 1);
+  put("/sys/class/power_supply/battery/lrp", "415\n");
+  wait_ms(150);
+  br_thermal_get(t, &state);
+  CHECK(state.cap == 1);
+  put("/sys/class/power_supply/battery/lrp", "390\n");
+  wait_ms(150);
+  br_thermal_get(t, &state);
+  CHECK(state.cap == 0);
+  br_thermal_close(t);
+}
+
 // The load line from fake /proc and battery files: two samples 30 s apart on an 8-CPU host.
 static char last_line[512];
 static void keep_line(int level, const char *line) { (void)level; if (!strncmp(line, "thermal: ", 9) && strstr(line, "host CPU")) snprintf(last_line, sizeof last_line, "%s", line); }
@@ -414,6 +435,7 @@ int main(void)
   test_masks();
   test_sysfs();
   test_worker();
+  test_early_cap();
   test_load();
   test_hal();
   char cmd[300];
