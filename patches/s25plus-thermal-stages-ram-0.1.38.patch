+      lo = (lo < floor_limit ? lo : floor_limit) & ~63u;
     }
     const uint32_t want = (lo | hi << 11) + 1;
     uint32_t tid = __atomic_load_n(&tp->tid, __ATOMIC_ACQUIRE);
