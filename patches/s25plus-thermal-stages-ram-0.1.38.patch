@@ -66,7 +66,9 @@ void br_thermal_decide(const br_thermal_limits *l, const br_thermal_raw *raw, co
 // at SLEEPING (50 C) or the battery rule at TRAPPING (50 C); then BR_THERMAL_CAP_CRITICAL, only the slowest P domain and
