diff --git a/runtime/xnuhost/src/main.c b/runtime/xnuhost/src/main.c
index b1c8db5..7a80b69 100644
--- a/runtime/xnuhost/src/main.c
+++ b/runtime/xnuhost/src/main.c
@@ -370,9 +370,18 @@ static void thermal_step(void *ctx, const br_thermal_state *state)
   if (config.s25plus)
     __atomic_store_n(&xh_cpu_thermal_step, state->cap, __ATOMIC_RELAXED);
   if (!cpu_planned) return;
-  br_cpu_plan_cap(&cpu_plan, &cpu_plan_base, &cpu_host, state->cap);
-  __atomic_fetch_add(&xh_cpu_place_epoch, 1, __ATOMIC_ACQ_REL);
-  for (unsigned i = 0; i < cpu_plan.nvcpu; i++) { int tid = vcpu_tid(i); if (tid > 0) place(tid, i); }
+  uint64_t before[XH_MAX_CPUS];
+  for (unsigned i = 0; i < cpu_plan.nvcpu; i++) before[i] = place_mask(i);
+  unsigned affinity_step = state->cap == BR_THERMAL_CAP_HOT ? BR_THERMAL_CAP_WARM : state->cap;
+  br_cpu_plan_cap(&cpu_plan, &cpu_plan_base, &cpu_host, affinity_step);
+  bool changed = false;
+  for (unsigned i = 0; i < cpu_plan.nvcpu; i++) {
+    if (before[i] == place_mask(i)) continue;
+    changed = true;
+    int tid = vcpu_tid(i);
+    if (tid > 0) place(tid, i);
+  }
+  if (changed) __atomic_fetch_add(&xh_cpu_place_epoch, 1, __ATOMIC_ACQ_REL);
   uint64_t p = cpu_plan.nvcpu ? __atomic_load_n(&cpu_plan.v[cpu_plan.nvcpu - 1].affinity, __ATOMIC_ACQUIRE) : 0;
   LOGI("thermal: step %u (%s): P vCPUs on host CPUs 0x%llx%s", state->cap, br_thermal_level_name(state->level), (unsigned long long)p,
        state->cap ? "" : " (all of their kind)");
