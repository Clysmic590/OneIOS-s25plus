diff --git a/runtime/xnuhost/tests/test_xnuhost.c b/runtime/xnuhost/tests/test_xnuhost.c
index ec8f770..98079be 100644
--- a/runtime/xnuhost/tests/test_xnuhost.c
+++ b/runtime/xnuhost/tests/test_xnuhost.c
@@ -1204,6 +1204,32 @@ static unsigned input_take(driver *d, test_ev *out, unsigned max)
   return n;
 }
 
+static void test_input_coalescing(void)
+{
+  driver d = { .dev = xh_virtio_input_create(0, 43) };
+  CHECK(d.dev && driver_init(&d, 0, 2, GUEST_PA + 0x10000));
+  xh_virtio_input_event(d.dev, 3, 0x39, 5);   // contact down
+  xh_virtio_input_event(d.dev, 0, 0, 0);
+  for (int x = 10; x <= 40; x += 10) {
+    xh_virtio_input_event(d.dev, 3, 0x35, x);
+    xh_virtio_input_event(d.dev, 3, 0x36, x + 1);
+    xh_virtio_input_event(d.dev, 4, 5, x * 100);
+    xh_virtio_input_event(d.dev, 0, 0, 0);
+  }
+  xh_virtio_input_event(d.dev, 3, 0x39, -1);   // contact up
+  xh_virtio_input_event(d.dev, 0, 0, 0);
+  CHECK(xh_virtio_input_backlog(d.dev) == 8);
+  for (unsigned i = 0; i < 8; i++)
+    driver_send(&d, 0, (const uint64_t[][3]){ { GUEST_PA + 0x50000 + i * 8, 8, 1 } }, 1, false);
+  W(&d, 0x50, 0);
+  test_ev events[12];
+  CHECK(input_take(&d, events, 12) == 8);
+  CHECK(events[0].code == 0x39 && events[0].value == 5 && events[1].type == 0);
+  CHECK(events[2].code == 0x35 && events[2].value == 40 && events[3].code == 0x36 && events[3].value == 41);
+  CHECK(events[4].type == 4 && events[4].value == 4000 && events[5].type == 0);
+  CHECK(events[6].code == 0x39 && events[6].value == -1 && events[7].type == 0);
+}
