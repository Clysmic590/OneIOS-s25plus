+static input_event *queued(input_state *s, unsigned offset)
+{
+  return &s->backlog[(s->head + offset) % BACKLOG];
+}
+
+static bool report_end(const input_event *event)
+{
+  return event->type == EV_SYN_ && event->code == SYN_REPORT_;
+}
+
+static unsigned report_start(input_state *s, unsigned end)
+{
+  unsigned first = end;
+  while (first && end - first < 32 && !report_end(queued(s, first - 1))) first--;
+  return first;
+}
+
+// Keep the newest of two fully queued motion reports only when they update the
+// same fields on the same slots. Key and contact lifecycles stay in FIFO order.
+static void merge_motion(input_state *s)
+{
+  unsigned end = s->count - 1, newer = report_start(s, end);
+  if (!newer || !report_end(queued(s, newer - 1))) return;
+  unsigned older = report_start(s, newer - 1);
+  if ((!older && s->partial) || (older && !report_end(queued(s, older - 1))) ||
+      newer - older != s->count - newer) return;
+
+  bool explicit_slot = false, motion = false;
+  for (unsigned i = 0; i < end - newer; i++) {
+    const input_event *a = queued(s, older + i), *b = queued(s, newer + i);
+    if (a->type != b->type || a->code != b->code) return;
+    if (b->type == EV_MSC_ && b->code == MSC_TIMESTAMP_) continue;
+    if (b->type != EV_ABS_) return;
+    switch (b->code) {
+    case ABS_MT_SLOT_:
+      if (a->value != b->value || (!explicit_slot && motion)) return;
+      explicit_slot = true;
+      break;
+    case ABS_MT_POSITION_X_: case ABS_MT_POSITION_Y_: case ABS_MT_PRESSURE_: case ABS_MT_TOUCH_MAJOR_:
+      motion = true;
+      break;
+    default:
+      return;
+    }
+  }
+  if (!motion) return;
+  for (unsigned i = 0; i <= end - newer; i++) *queued(s, older + i) = *queued(s, newer + i);
+  s->count = newer;
+}
+
